{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ansible-flow-hub": {
      "type": "local",
      "command": [
        "ssh",
        "-o",
        "BatchMode=yes",
        "ansible-flow@hub.example",
        "ansible-flow-mcp",
        "hub",
        "session"
      ],
      "enabled": true
    }
  }
}
