{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ansible-flow-hub": {
      "type": "local",
      "command": ["ansible-flow-mcp", "hub", "session"],
      "enabled": true,
      "environment": {
        "ANSIBLE_FLOW_HUB_DIR": "/var/lib/ansible-flow/hub",
        "ANSIBLE_FLOW_ROLE": "hub"
      }
    }
  }
}
