# Multi-family spoke image. BASE_IMAGE + SPOKE_FAMILY select OS packaging.
# The test lab pins BASE_IMAGE in test-env/flavors.yml (Fedora 44, Alpine 3.24).
ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}

ARG SPOKE_FAMILY=debian
ENV SPOKE_FAMILY=${SPOKE_FAMILY} \
    ANSIBLE_FLOW_ROLE=spoke \
    ANSIBLE_FLOW_SPOKE_DIR=/var/lib/ansible-flow/spoke \
    PATH="/usr/local/bin:${PATH}"

COPY lab/images/install-spoke-deps.sh /tmp/install-spoke-deps.sh
RUN chmod +x /tmp/install-spoke-deps.sh && /tmp/install-spoke-deps.sh "${SPOKE_FAMILY}"

WORKDIR /opt/ansible-flow-mcp
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY catalog ./catalog
COPY lab/images/entrypoint-spoke.sh /usr/local/bin/entrypoint-spoke.sh
COPY lab/images/spoke-test-autojoin.sh /usr/local/bin/spoke-test-autojoin.sh
COPY lab/images/retry_delay.py /usr/local/bin/retry_delay.py
COPY lab/images/sshd/spoke.conf /etc/ssh/sshd_config.d/ansible-flow-spoke.conf
COPY examples/sshd/ansible-flow-spoke.conf /etc/ssh/sshd_config.d/ansible-flow-spoke-force.conf

RUN set -eux; \
    pip_install() { \
      if python3 -m pip install --no-cache-dir --break-system-packages -e . ; then return 0; fi; \
      if command -v pip3 >/dev/null 2>&1 && pip3 install --no-cache-dir --break-system-packages -e . ; then return 0; fi; \
      python3 -m pip install --no-cache-dir -e . ; \
    }; \
    if ! pip_install; then \
      echo "pip failed; installing build packages and retrying" >&2; \
      case "${SPOKE_FAMILY}" in \
        alpine) apk add --no-cache build-base python3-dev musl-dev libffi-dev openssl-dev ;; \
        debian|ubuntu) apt-get update && apt-get install -y --no-install-recommends build-essential python3-dev libffi-dev && rm -rf /var/lib/apt/lists/* ;; \
        *) if command -v dnf >/dev/null 2>&1; then dnf install -y gcc python3-devel libffi-devel && dnf clean all; \
           elif command -v microdnf >/dev/null 2>&1; then microdnf install -y gcc python3-devel libffi-devel && microdnf clean all; fi ;; \
      esac; \
      pip_install; \
    fi; \
    BIN="$(command -v ansible-flow-mcp)"; \
    if [ -n "$BIN" ] && [ "$BIN" != /usr/local/bin/ansible-flow-mcp ]; then \
      ln -sfn "$BIN" /usr/local/bin/ansible-flow-mcp; \
    fi; \
    test -x /usr/local/bin/ansible-flow-mcp || test -x "$BIN"; \
    chmod +x /usr/local/bin/entrypoint-spoke.sh /usr/local/bin/spoke-test-autojoin.sh /usr/local/bin/retry_delay.py; \
    mkdir -p /var/lib/ansible-flow/spoke /var/run/sshd \
      /home/mcp-spoke/.ssh /home/mcp-ansible/.ssh; \
    if ! id mcp-spoke >/dev/null 2>&1; then \
      useradd -m -s /usr/sbin/nologin mcp-spoke 2>/dev/null \
        || adduser -D -s /sbin/nologin mcp-spoke; \
    fi; \
    if ! id mcp-ansible >/dev/null 2>&1; then \
      useradd -m -s /bin/bash mcp-ansible 2>/dev/null \
        || adduser -D -s /bin/bash mcp-ansible; \
    fi; \
    # OpenSSH rejects locked accounts (passwd '!'); keep key-only, unlocked.
    usermod -p '*' mcp-ansible 2>/dev/null \
      || passwd -u mcp-ansible 2>/dev/null \
      || passwd -d mcp-ansible 2>/dev/null \
      || true; \
    # lab: passwordless sudo so run_module(become=true) works for package etc.
    if command -v sudo >/dev/null 2>&1; then \
      echo 'mcp-ansible ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/mcp-ansible; \
      chmod 440 /etc/sudoers.d/mcp-ansible; \
    fi; \
    chown -R mcp-spoke:mcp-spoke /home/mcp-spoke /var/lib/ansible-flow/spoke; \
    chown -R mcp-ansible:mcp-ansible /home/mcp-ansible; \
    chmod 700 /home/mcp-spoke/.ssh /home/mcp-ansible/.ssh; \
    chmod -R a+rX /opt/ansible-flow-mcp; \
    ssh-keygen -A || true; \
    SSHD="$(command -v sshd || true)"; \
    if [ -z "$SSHD" ]; then \
      for c in /usr/sbin/sshd /sbin/sshd; do [ -x "$c" ] && SSHD=$c && break; done; \
    fi; \
    if [ -n "$SSHD" ]; then \
      "$SSHD" -t || { sed -i '/ChallengeResponseAuthentication/d;/KbdInteractiveAuthentication/d' /etc/ssh/sshd_config.d/ansible-flow-spoke.conf; "$SSHD" -t; }; \
    fi

EXPOSE 22
COPY lab/images/spoke-init.sh /usr/local/bin/spoke-init.sh
RUN chmod +x /usr/local/bin/spoke-init.sh
ENTRYPOINT ["/usr/local/bin/spoke-init.sh"]
