      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "organization",
      "displayName": "Organization",
      "type": "string",
      "required": false,
      "default": null,
      "description": "ScaleWay organization ID to which volume belongs.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "profile",
      "displayName": "Profile",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The config profile in config file to load the Scaleway OAuth token from, use instead of O(api_token). It is also possible to set E(SCW_PROFILE) to use a SCW CLI config profile.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "project",
      "displayName": "Project",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Scaleway project ID to which volume belongs.",
      "choices": null,
      "noLog": false,
      "suboptions": null
