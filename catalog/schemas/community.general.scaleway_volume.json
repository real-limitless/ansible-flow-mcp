{
  "fqcn": "community.general.scaleway_volume",
  "shortDescription": "Scaleway volumes management module",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/scaleway_volume_module.html",
  "options": [
    {
      "name": "api_timeout",
      "displayName": "Api Timeout",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "HTTP timeout to Scaleway API in seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_token",
      "displayName": "Api Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Scaleway OAuth token. This is required if O(profile) is not specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_url",
      "displayName": "Api Url",
      "type": "string",
      "required": false,
      "default": "https://api.scaleway.com",
      "description": "Scaleway API URL.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
