      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "region",
      "displayName": "Region",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Scaleway region to use (for example par1).",
      "choices": [
        "ams1",
        "EMEA-NL-EVS",
        "ams2",
        "ams3",
        "par1",
        "EMEA-FR-PAR1",
        "par2",
        "EMEA-FR-PAR2",
        "par3",
        "waw1",
        "EMEA-PL-WAW1",
        "waw2",
        "waw3"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "size",
      "displayName": "Size",
      "type": "number",
      "required": false,
