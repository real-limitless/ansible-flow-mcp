      "noLog": false,
      "suboptions": null
    },
    {
      "name": "version",
      "displayName": "Version",
      "type": "string",
      "required": false,
      "default": "latest",
      "description": "Version of the plugin to install.",
      "choices": null,
      "noLog": false,
      "suboptions": null
