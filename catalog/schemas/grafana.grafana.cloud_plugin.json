{
  "fqcn": "grafana.grafana.cloud_plugin",
  "shortDescription": "Manage Grafana Cloud Plugins",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/grafana/grafana/cloud_plugin_module.html",
  "options": [
    {
      "name": "cloud_api_key",
      "displayName": "Cloud Api Key",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Cloud API Key to authenticate with Grafana Cloud.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the plugin, e.g. grafana-github-datasource.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "stack_slug",
      "displayName": "Stack Slug",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the Grafana Cloud stack to which the plugin will be added.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
