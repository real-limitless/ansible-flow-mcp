      "choices": [
        "http",
        "https"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The name of rewriting rule.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "object",
      "displayName": "Object",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Select which part of the HTTP request will be tested for a match.",
      "choices": [
        "http-host",
        "http-url",
        "http-location"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "protocol_filter",
      "displayName": "Protocol Filter",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Protocol Filter.",
      "choices": [
        "enable",
        "disable"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "reg_exp",
      "displayName": "Reg Exp",
      "type": "string",
      "required": false,
      "default": null,
      "description": "A regular Expression that defines either all matching or all non-matching objects..",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "reverse_match",
      "displayName": "Reverse Match",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Indicate how to use Regular Expression when determining whether or not this URL rewriting condition is met.",
      "choices": [
        "\"yes\" (Object does not match the regular expression)",
        "\"no\" (Object matches the regular expressionn)"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
