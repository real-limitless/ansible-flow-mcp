{
  "fqcn": "pfsensible.core.pfsense_haproxy_backend",
  "shortDescription": "Manage pfSense HAProxy backends",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/pfsensible/core/pfsense_haproxy_backend_module.html",
  "options": [
    {
      "name": "balance",
      "displayName": "Balance",
      "type": "string",
      "required": false,
      "default": "none",
      "description": "The load balancing option.",
      "choices": [
        "none",
        "roundrobin",
        "static-rr",
        "leastconn",
        "source",
        "uri"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "balance_uridepth",
      "displayName": "Balance Uridepth",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Indicates the maximum directory depth to be used to compute the hash. One level is counted for each slash in the request.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "balance_urilen",
      "displayName": "Balance Urilen",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Indicates that the algorithm should only consider that many characters at the beginning of the URI to compute the hash.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "balance_uriwhole",
      "displayName": "Balance Uriwhole",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Allow using whole URI including url parameters behind a question mark.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "check_frequency",
      "displayName": "Check Frequency",
      "type": "number",
      "required": false,
      "default": null,
      "description": "The check interval (in milliseconds). For HTTP/HTTPS defaults to 1000 if left blank. For TCP no check will be performed if left empty.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "check_type",
      "displayName": "Check Type",
      "type": "string",
      "required": false,
      "default": "none",
      "description": "Health check method.",
      "choices": [
        "none",
        "Basic",
        "HTTP",
        "Agent",
        "LDAP",
        "MySQL",
        "PostgreSQL",
        "Redis",
        "SMTP",
        "ESMTP",
        "SSL"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "connection_timeout",
      "displayName": "Connection Timeout",
      "type": "number",
      "required": false,
      "default": null,
      "description": "The time (in milliseconds) we give up if the connection does not complete within (default 30000).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "httpcheck_method",
      "displayName": "Httpcheck Method",
      "type": "string",
      "required": false,
      "default": null,
      "description": "HTTP check method.",
      "choices": [
        "OPTIONS",
        "HEAD",
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "TRACE"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "log_checks",
      "displayName": "Log Checks",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "When this option is enabled, any change of the health check status or to the server's health will be logged.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "monitor_domain",
      "displayName": "Monitor Domain",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Domain used in checks (SMTP and ESMTP)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "monitor_httpversion",
      "displayName": "Monitor Httpversion",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Defaults to \"HTTP/1.0\" if left blank.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "monitor_uri",
      "displayName": "Monitor Uri",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Url used by http check requests.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "monitor_username",
      "displayName": "Monitor Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Username used in checks (MySQL and PostgreSQL)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The backend name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "retries",
      "displayName": "Retries",
      "type": "number",
      "required": false,
      "default": null,
      "description": "After a connection failure to a server, it is possible to retry, potentially on another server.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server_timeout",
      "displayName": "Server Timeout",
      "type": "number",
      "required": false,
      "default": null,
      "description": "The time (in milliseconds) we accept to wait for data from the server, or for the server to accept data (default 30000).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State in which to leave the backend",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
