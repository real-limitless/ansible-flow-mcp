{
  "fqcn": "hpe.nimble.hpe_nimble_performance_policy",
  "shortDescription": "Manage the HPE Nimble Storage performance policies",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/hpe/nimble/hpe_nimble_performance_policy_module.html",
  "options": [
    {
      "name": "app_category",
      "displayName": "App Category",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the application category of the associated volume.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "block_size",
      "displayName": "Block Size",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Block Size in bytes to be used by the volumes created with this specific performance policy. Supported block sizes are 4096 bytes (4 KB), 8192 bytes (8 KB), 16384 bytes(16 KB), and 32768 bytes (32 KB). Block size of a performance policy cannot be changed once the performance policy is created.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "cache",
      "displayName": "Cache",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Flag denoting if data in the associated volume should be cached.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "cache_policy",
      "displayName": "Cache Policy",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies how data of associated volume should be cached. Normal policy caches data but skips in certain conditions such as sequential I/O. Aggressive policy will accelerate caching of all data belonging to this volume, regardless of sequentiality.",
      "choices": [
        "disabled",
        "normal",
        "aggressive",
        "no_write",
        "aggressive_read_no_write"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "change_name",
      "displayName": "Change Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Change name of the existing performance policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "compress",
      "displayName": "Compress",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Flag denoting if data in the associated volume should be compressed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dedupe",
      "displayName": "Dedupe",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Specifies if dedupe is enabled for volumes created with this performance policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Description of a performance policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": true,
      "default": null,
      "description": "HPE Nimble Storage IP address.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the performance policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "HPE Nimble Storage password.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "space_policy",
      "displayName": "Space Policy",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the state of the volume upon space constraint violation such as volume limit violation or volumes above their volume reserve, if the pool free space is exhausted. Supports two policies, 'offline' and 'non_writable'.",
      "choices": [
        "invalid",
        "offline",
        "non_writable",
        "read_only",
        "login_only"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The performance policy operation.",
      "choices": [
        "present",
        "absent",
        "create"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": true,
      "default": null,
      "description": "HPE Nimble Storage user name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
