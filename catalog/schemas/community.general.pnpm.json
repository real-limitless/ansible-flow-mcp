{
  "fqcn": "community.general.pnpm",
  "shortDescription": "Manage Node.js packages with C(pnpm)",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/pnpm_module.html",
  "options": [
    {
      "name": "alias",
      "displayName": "Alias",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Alias of the Node.js library.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dev",
      "displayName": "Dev",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Install dependencies in development mode. Pnpm ignores any regular dependencies in C(package.json).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "executable",
      "displayName": "Executable",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The executable location for pnpm. The default location it searches for is E(PATH), fails if not set.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "global",
      "displayName": "Global",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Install the Node.js library globally.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ignore_scripts",
      "displayName": "Ignore Scripts",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Use the C(--ignore-scripts) flag when installing.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The name of a Node.js library to install. All packages in C(package.json) are installed if not provided.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "no_optional",
      "displayName": "No Optional",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Do not install optional packages, equivalent to C(--no-optional).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "optional",
      "displayName": "Optional",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Install dependencies in optional mode.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "path",
      "displayName": "Path",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The base path to install the Node.js libraries.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "production",
      "displayName": "Production",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Install dependencies in production mode. Pnpm ignores any dependencies under C(devDependencies) in package.json.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Installation state of the named Node.js library. If V(absent) is selected, a name option must be provided.",
      "choices": [
        "present",
        "absent",
        "latest"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "version",
      "displayName": "Version",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The version of the library to be installed, in semver format.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
