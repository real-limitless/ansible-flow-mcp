{
  "fqcn": "community.cassandra.cassandra_concurrency",
  "shortDescription": "Manage concurrency parameters on the Cassandra node.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/cassandra/cassandra_concurrency_module.html",
  "options": [
    {
      "name": "cassandra_version",
      "displayName": "Cassandra Version",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Version of Cassandra being connected to by nodetool. If a value if not provided we use `nodetool version`to auto-discover it.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "concurrency_stage",
      "displayName": "Concurrency Stage",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The processing stage Only relevent when concurrency_type is default",
      "choices": [
        "AntiEntropyStage",
        "CounterMutationStage",
        "GossipStage",
        "ImmediateStage",
        "InternalResponseStage",
        "MigrationStage",
        "MiscStage",
        "MutationStage",
        "ReadStage",
        "RequestResponseStage",
        "TracingStage",
        "ViewMutationStage"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "concurrency_type",
      "displayName": "Concurrency Type",
      "type": "string",
      "required": false,
      "default": "default",
      "description": "Type of concurrency to manage.",
      "choices": [
        "default",
        "compactors",
        "viewbuilders"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable additional debug output.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": false,
      "default": "127.0.0.1",
      "description": "The hostname.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "nodetool_flags",
      "displayName": "Nodetool Flags",
      "type": "string",
      "required": false,
      "default": "-Dcom.sun.jndi.rmiURLParsing=legacy",
      "description": "Flags to pass to nodetool.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "nodetool_path",
      "displayName": "Nodetool Path",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The path to nodetool.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The password to authenticate with.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password_file",
      "displayName": "Password File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Path to a file containing the password.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": 7199,
      "description": "The Cassandra TCP port.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The username to authenticate with.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "value",
      "displayName": "Value",
      "type": "number",
      "required": true,
      "default": null,
      "description": "Number of threads / maximum concurrency.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
