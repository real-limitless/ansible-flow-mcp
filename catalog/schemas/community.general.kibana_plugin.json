{
  "fqcn": "community.general.kibana_plugin",
  "shortDescription": "Manage Kibana plugins",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/kibana_plugin_module.html",
  "options": [
    {
      "name": "allow_root",
      "displayName": "Allow Root",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether to allow C(kibana) and C(kibana-plugin) to be run as root. Passes the C(--allow-root) flag to these commands.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "force",
      "displayName": "Force",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Delete and re-install the plugin. It can be useful for plugins update.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the plugin to install.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "plugin_bin",
      "displayName": "Plugin Bin",
      "type": "string",
      "required": false,
      "default": "/opt/kibana/bin/kibana",
      "description": "Location of the Kibana binary.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "plugin_dir",
      "displayName": "Plugin Dir",
      "type": "string",
      "required": false,
      "default": "/opt/kibana/installedPlugins/",
      "description": "Your configured plugin directory specified in Kibana.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired state of a plugin.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "string",
      "required": false,
      "default": "1m",
      "description": "Timeout setting: V(30s), V(1m), V(1h) and so on.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "url",
      "displayName": "Url",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Set exact URL to download the plugin from. For local file, prefix its absolute path with C(file://).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "version",
      "displayName": "Version",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Version of the plugin to be installed. If the plugin is installed with in a previous version, it is B(not) updated unless O(force=true).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
