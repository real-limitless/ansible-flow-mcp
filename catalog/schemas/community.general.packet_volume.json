{
  "fqcn": "community.general.packet_volume",
  "shortDescription": "Create/delete a volume in Packet host",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/packet_volume_module.html",
  "options": [
    {
      "name": "auth_token",
      "displayName": "Auth Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Packet API token. You can also supply it in environment variable E(PACKET_API_TOKEN).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "billing_cycle",
      "displayName": "Billing Cycle",
      "type": "string",
      "required": false,
      "default": "hourly",
      "description": "Billing cycle for new volume.",
      "choices": [
        "hourly",
        "monthly"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": null,
      "description": "User-defined description attribute for Packet volume. It is used used as idempotent identifier - if volume with given description exists, new one is not created.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "facility",
      "displayName": "Facility",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Location of the volume. Volumes can only be attached to device in the same location.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "id",
      "displayName": "Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "UUID of a volume.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "locked",
      "displayName": "Locked",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Create new volume locked.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Selector for API-generated name of the volume.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "plan",
      "displayName": "Plan",
      "type": "string",
      "required": false,
      "default": "storage_1",
      "description": "V(storage_1) for standard tier, V(storage_2) for premium (performance) tier. Tiers are described at U(https://www.packet.com/cloud/storage/).",
      "choices": [
        "storage_1",
        "storage_2"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "project_id",
      "displayName": "Project Id",
      "type": "string",
      "required": true,
      "default": null,
      "description": "ID of project of the device.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "size",
      "displayName": "Size",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Size of the volume in gigabytes.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "snapshot_policy",
      "displayName": "Snapshot Policy",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "Snapshot policy for new volume.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired state of the volume.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
