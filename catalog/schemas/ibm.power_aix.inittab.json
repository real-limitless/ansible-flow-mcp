  "options": [
    {
      "name": "action",
      "displayName": "Action",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Specifies the action init will perform.",
      "choices": [
        "boot",
        "bootwait",
        "hold",
        "initdefault",
        "off",
        "once",
        "ondemand",
        "powerfail",
        "powerwait",
        "respawn",
        "sysinit",
        "wait"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "command",
      "displayName": "Command",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Specifies the command to run.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "insertafter",
      "displayName": "Insertafter",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the name of the entry to write the new entry after.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Specifies the name of the entry to manage.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "runlevel",
      "displayName": "Runlevel",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Specifies the run levels in which the I(name) can be processed. The format is the level number next to each other without separators, such as C('235789').",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Specifies the action to be performed for the entry. C(present) creates the entry in the /etc/inittab file. C(absent) deletes an existing entry. C(modify) changes an existing entry.",
      "choices": [
        "present",
        "absent",
        "modify"
      ],
      "noLog": false,
      "suboptions": null
    }
