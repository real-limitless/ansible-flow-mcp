{
  "fqcn": "nvidia.nvue.api",
  "shortDescription": "Use httpapi to run command on NVUE devices",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/nvidia/nvue/api_module.html",
  "options": [
    {
      "name": "data",
      "displayName": "Data",
      "type": "dict",
      "required": false,
      "default": {},
      "description": "Structured data used with \"set\" operations.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "filled",
      "displayName": "Filled",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "If true, fill in attributes with default values, providing a complete set of attributes. If false, return only the attributes that differ from the defaults.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "force",
      "displayName": "Force",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "When true, replies \"yes\" to NVUE prompts.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "operation",
      "displayName": "Operation",
      "type": "string",
      "required": false,
      "default": "get",
      "description": "Type of API operation",
      "choices": [
        "get",
        "set"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "path",
      "displayName": "Path",
      "type": "string",
      "required": false,
      "default": "/",
      "description": "API path that will be appended to \"/nvue_v1\"",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "revid",
      "displayName": "Revid",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Revision ID to query/to apply config to",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "wait",
      "displayName": "Wait",
      "type": "number",
      "required": false,
      "default": 0,
      "description": "How long to poll for \"set\" operation results.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
