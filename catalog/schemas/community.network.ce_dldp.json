{
  "fqcn": "community.network.ce_dldp",
  "shortDescription": "Manages global DLDP configuration on HUAWEI CloudEngine switches.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/network/ce_dldp_module.html",
  "options": [
    {
      "name": "auth_mode",
      "displayName": "Auth Mode",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies authentication algorithm of DLDP.",
      "choices": [
        "md5",
        "simple",
        "sha",
        "hmac-sha256",
        "none"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_pwd",
      "displayName": "Auth Pwd",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies authentication password. The value is a string of 1 to 16 case-sensitive plaintexts or 24/32/48/108/128 case-sensitive encrypted characters. The string excludes a question mark (?).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enable",
      "displayName": "Enable",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Set global DLDP enable state.",
      "choices": [
        "enable",
        "disable"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "reset",
      "displayName": "Reset",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specify whether reset DLDP state of disabled interfaces.",
      "choices": [
        "enable",
        "disable"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "time_internal",
      "displayName": "Time Internal",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the interval for sending Advertisement packets. The value is an integer ranging from 1 to 100, in seconds. The default interval for sending Advertisement packets is 5 seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "work_mode",
      "displayName": "Work Mode",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Set global DLDP work-mode.",
      "choices": [
        "enhance",
        "normal"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
