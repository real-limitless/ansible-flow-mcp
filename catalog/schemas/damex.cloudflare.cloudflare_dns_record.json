{
  "fqcn": "damex.cloudflare.cloudflare_dns_record",
  "shortDescription": "Ensure Cloudflare DNS record",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/damex/cloudflare/cloudflare_dns_record_module.html",
  "options": [
    {
      "name": "account_api_key",
      "displayName": "Account Api Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Cloudflare account API key. Required together with O(account_email) if O(api_token) is not provided.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "account_email",
      "displayName": "Account Email",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Cloudflare account email. Required together with O(account_api_key) if O(api_token) is not provided.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_token",
      "displayName": "Api Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Cloudflare API token. Required if O(account_email) and O(account_api_key) are not provided. Can be specified in E(CLOUDFLARE_TOKEN) environment variable.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "content",
      "displayName": "Content",
      "type": "string",
      "required": false,
      "default": null,
      "description": "DNS record content. Required when O(state) is C(present).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "priority",
      "displayName": "Priority",
      "type": "number",
      "required": false,
      "default": null,
      "description": "DNS record priority. Required for MX and URI records.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "proxied",
      "displayName": "Proxied",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Cloudflare proxy status. Only applicable to A, AAAA, and CNAME records.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "record",
      "displayName": "Record",
      "type": "string",
      "required": true,
      "default": null,
      "description": "DNS record name (subdomain or @ for zone apex).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "DNS record state.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ttl",
      "displayName": "Ttl",
      "type": "number",
      "required": false,
      "default": 1,
      "description": "DNS record TTL in seconds. Value of 1 means automatic.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "type",
      "displayName": "Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "DNS record type.",
      "choices": [
        "A",
        "AAAA",
        "CAA",
        "CNAME",
        "DS",
        "HTTPS",
        "MX",
        "NAPTR",
        "NS",
        "PTR",
        "SMIMEA",
        "SRV",
        "SSHFP",
        "SVCB",
        "TLSA",
        "TXT",
        "URI"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone_id",
      "displayName": "Zone Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Zone identifier. Required if O(zone_name) is not provided.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone_name",
      "displayName": "Zone Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Zone domain name. Required if O(zone_id) is not provided. Resolved to zone identifier via the Cloudflare API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
