{
  "fqcn": "h3c_open.comware.comware_switchport",
  "shortDescription": "Manage Layer 2 parameters on switchport interfaces",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/h3c_open/comware/comware_switchport_module.html",
  "options": [
    {
      "name": "link_type",
      "displayName": "Link Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Layer 2 mode of the interface",
      "choices": [
        "access",
        "trunk",
        "hybrid"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Full name of the interface",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "permitted_vlans",
      "displayName": "Permitted Vlans",
      "type": "string",
      "required": false,
      "default": null,
      "description": "If mode is set to trunk this will be the complete list/range (as a string) of VLANs allowed on that trunk interface. E.g. 1-3,5,8-10 Any VLAN not in the list will be removed from the interface.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pvid",
      "displayName": "Pvid",
      "type": "string",
      "required": false,
      "default": null,
      "description": "If link_type is set to trunk this will be used as the native native VLAN ID for that trunk. If link_type is set to access then this is the VLAN ID of the interface.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired state of the switchport",
      "choices": [
        "present",
        "default",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "taggedvlan",
      "displayName": "Taggedvlan",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Assign hybrid port to tagged VLANs E.g. 1-3,5,8-10",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "untaggedvlan",
      "displayName": "Untaggedvlan",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Assign hybrid port to untagged VLANs E.g. 1-3,5,8-10",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
