{
  "fqcn": "community.rabbitmq.rabbitmq_upgrade",
  "shortDescription": "Execute rabbitmq-upgrade commands",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/rabbitmq/rabbitmq_upgrade_module.html",
  "options": [
    {
      "name": "action",
      "displayName": "Action",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Specify action to be executed.",
      "choices": [
        "await_online_quorum_plus_one",
        "await_online_synchronized_mirror",
        "post_upgrade",
        "drain",
        "revive"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "node",
      "displayName": "Node",
      "type": "string",
      "required": false,
      "default": "rabbit",
      "description": "Erlang node name of the target rabbit node.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
