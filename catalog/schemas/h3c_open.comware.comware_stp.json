{
  "fqcn": "h3c_open.comware.comware_stp",
  "shortDescription": "Manage stp global BPDU enable, working mode and tc-bpdu attack protection function.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/h3c_open/comware/comware_stp_module.html",
  "options": [
    {
      "name": "bpdu",
      "displayName": "Bpdu",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Turn on the global BPDU protection function.",
      "choices": [
        "true",
        "false"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mode",
      "displayName": "Mode",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Configure the working mode of the spanning tree.",
      "choices": [
        "MSTP",
        "PVST",
        "RSTP",
        "STP"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired state for the interface configuration",
      "choices": [
        "present",
        "absent",
        "default"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "tc",
      "displayName": "Tc",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Enable anti tc-bpdu attack protection function.",
      "choices": [
        "true",
        "false"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
