{
  "fqcn": "arensb.truenas.sharing_webdav",
  "shortDescription": "Manage WebDAV shares",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/arensb/truenas/sharing_webdav_module.html",
  "options": [
    {
      "name": "chown",
      "displayName": "Chown",
      "type": "string",
      "required": false,
      "default": true,
      "description": "If true, change the ownership of all files to user C(webdav), group C(webdav). If false, files to be shared must be manually updated to be owned by group C(webdav) or C(www).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Human-readable description of the share.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enabled",
      "displayName": "Enabled",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "If true, the share is enabled. Otherwise, it is present but disabled. This has no effect if C(state) is C(absent).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the share. This is an identifier.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "path",
      "displayName": "Path",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Directory (path) to be shared.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ro",
      "displayName": "Ro",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If true, this share is read-only, i.e., users may not write to it.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the share should exist or not.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
