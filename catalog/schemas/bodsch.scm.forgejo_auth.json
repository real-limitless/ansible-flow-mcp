{
  "fqcn": "bodsch.scm.forgejo_auth",
  "shortDescription": "Manage Forgejo LDAP authentication entries.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/bodsch/scm/forgejo_auth_module.html",
  "options": [
    {
      "name": "active",
      "displayName": "Active",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether the authentication source is active in Forgejo.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "allow_deactivate_all",
      "displayName": "Allow Deactivate All",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Allow empty search results to deactivate all users.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "attributes",
      "displayName": "Attributes",
      "type": "dict",
      "required": true,
      "default": null,
      "description": "Mapping of LDAP attributes to Forgejo fields.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "attributes_in_bind",
      "displayName": "Attributes In Bind",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Fetch attributes in bind DN context.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "bind_dn",
      "displayName": "Bind Dn",
      "type": "string",
      "required": true,
      "default": null,
      "description": "DN of the LDAP user used to bind and search the directory.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "bind_password",
      "displayName": "Bind Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Password for the bind DN.",
      "choices": null,
      "noLog": true,
      "suboptions": null
    },
    {
      "name": "cache_dir",
      "displayName": "Cache Dir",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Directory used to store checksum/state for idempotency. If omitted, defaults to C(<working_dir>/.ansible/forgejo).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "config",
      "displayName": "Config",
      "type": "string",
      "required": false,
      "default": "/etc/forgejo/forgejo.ini",
      "description": "Path to the Forgejo configuration file.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "filters",
      "displayName": "Filters",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "Optional LDAP filters for users, admins, or restricted accounts.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hostname",
      "displayName": "Hostname",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Hostname or IP address of the LDAP server.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Unique name of the LDAP authentication source in Forgejo.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Port of the LDAP server (e.g. 389 for LDAP or 636 for LDAPS). If omitted, the Forgejo CLI default is used.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "security_protocol",
      "displayName": "Security Protocol",
      "type": "string",
      "required": false,
      "default": "Unencrypted",
      "description": "Security protocol used to connect to the LDAP server.",
      "choices": [
        "Unencrypted",
        "LDAPS",
        "StartTLS"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "skip_local_2fa",
      "displayName": "Skip Local 2Fa",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Skip local 2FA for LDAP users.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "skip_tls_verify",
      "displayName": "Skip Tls Verify",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Skip TLS certificate verification when connecting via LDAPS or StartTLS.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired state of the LDAP authentication source. C(present) ensures the authentication source is configured. C(absent) is currently not implemented and results in no change.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "synchronize_users",
      "displayName": "Synchronize Users",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable user synchronization.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "user_search_base",
      "displayName": "User Search Base",
      "type": "string",
      "required": true,
      "default": null,
      "description": "LDAP search base used to look up users.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "working_dir",
      "displayName": "Working Dir",
      "type": "string",
      "required": false,
      "default": "/var/lib/forgejo",
      "description": "Forgejo working directory.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
