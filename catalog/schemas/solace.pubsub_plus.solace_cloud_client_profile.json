      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "solace_cloud_home",
      "displayName": "Solace Cloud Home",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The Solace Cloud home region.",
      "choices": [
        "us",
        "au",
        "US",
        "AU",
        ""
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "solace_cloud_service_id",
      "displayName": "Solace Cloud Service Id",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The service id in Solace Cloud. Click on the service in Solace Cloud - the service id is in the URL. Either both (solace_cloud_api_token AND solace_cloud_service_id) must be provided or none.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "solace_cloud_settings",
      "displayName": "Solace Cloud Settings",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "JSON dictionary of additional configuration for the Solace Cloud API. See Reference documentation.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Target state.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 10,
      "description": "Connection timeout in seconds for the http request.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": false,
      "default": "admin",
      "description": "Administrator username for Solace Broker.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Flag to switch validation of client certificates on/off when using a secure connection.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "x_broker",
      "displayName": "X Broker",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Custom HTTP header with the broker virtual router id, if using a SEMPv2 Proxy/agent infrastructure.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
