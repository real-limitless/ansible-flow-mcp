{
  "fqcn": "solace.pubsub_plus.solace_cloud_client_profile",
  "shortDescription": "client profile for Solace Cloud",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/solace/pubsub_plus/solace_cloud_client_profile_module.html",
  "options": [
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": false,
      "default": "localhost",
      "description": "Hostname of Solace Broker.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the client profile. Maps to 'clientProfileName' in the API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": "admin",
      "description": "Administrator password for Solace Broker.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": 8080,
      "description": "Management port of Solace Broker.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "reverse_proxy",
      "displayName": "Reverse Proxy",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "Use a reverse proxy / api gateway. Note: B(Experimental. Not permitted for Solace Cloud API).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "secure_connection",
      "displayName": "Secure Connection",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If true, use https rather than http.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "solace_cloud_api_token",
      "displayName": "Solace Cloud Api Token",
      "type": "string",
      "required": true,
      "default": null,
