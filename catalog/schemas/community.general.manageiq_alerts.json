{
  "fqcn": "community.general.manageiq_alerts",
  "shortDescription": "Configuration of alerts in ManageIQ",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/manageiq_alerts_module.html",
  "options": [
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The unique alert description in ManageIQ. Required when state is \"absent\" or \"present\".",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enabled",
      "displayName": "Enabled",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Enable or disable the alert. Required if O(state=present).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "expression",
      "displayName": "Expression",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "The alert expression for ManageIQ. Can either be in the \"Miq Expression\" format or the \"Hash Expression format\". Required if O(state=present).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "expression_type",
      "displayName": "Expression Type",
      "type": "string",
      "required": false,
      "default": "hash",
      "description": "Expression type.",
      "choices": [
        "hash",
        "miq"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "manageiq_connection",
      "displayName": "Manageiq Connection",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "ManageIQ connection configuration information.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "options",
      "displayName": "Options",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "Additional alert options, such as notification type and frequency.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "resource_type",
      "displayName": "Resource Type",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The entity type for the alert in ManageIQ. Required when O(state=present).",
      "choices": [
        "Vm",
        "ContainerNode",
        "MiqServer",
        "Host",
        "Storage",
        "EmsCluster",
        "ExtManagementSystem",
        "MiddlewareServer"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "V(absent) - alert should not exist, V(present) - alert should exist.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    }
