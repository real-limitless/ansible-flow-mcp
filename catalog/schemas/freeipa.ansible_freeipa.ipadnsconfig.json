{
  "fqcn": "freeipa.ansible_freeipa.ipadnsconfig",
  "shortDescription": "Manage FreeIPA dnsconfig",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/freeipa/ansible_freeipa/ipadnsconfig_module.html",
  "options": [
    {
      "name": "action",
      "displayName": "Action",
      "type": "string",
      "required": false,
      "default": "dnsconfig",
      "description": "Work on dnsconfig or member level. It can be one of `member` or\n`dnsconfig`. Only `forwarders` can be managed with `action: member`.\n",
      "choices": [
        "member",
        "dnsconfig"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "allow_sync_ptr",
      "displayName": "Allow Sync Ptr",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Allow synchronization of forward (A, AAAA) and reverse (PTR) records.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "forward_policy",
      "displayName": "Forward Policy",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Global forwarding policy. Set to \"none\" to disable any configured global forwarders.",
      "choices": [
        "only",
        "first",
        "none"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "forwarders",
      "displayName": "Forwarders",
      "type": "list",
      "required": false,
      "default": null,
      "description": "The list of global DNS forwarders.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ipaadmin_password",
      "displayName": "Ipaadmin Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The admin password.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ipaadmin_principal",
      "displayName": "Ipaadmin Principal",
      "type": "string",
      "required": false,
      "default": "admin",
      "description": "The admin principal.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ipaapi_context",
      "displayName": "Ipaapi Context",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The context in which the module will execute. Executing in a\nserver context is preferred. If not provided context will be\ndetermined by the execution environment.\n",
      "choices": [
        "server",
        "client"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ipaapi_ldap_cache",
      "displayName": "Ipaapi Ldap Cache",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Use LDAP cache for IPA connection.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The state to ensure. It can be one of `present` or `absent`.\n`absent` can only be used with `action: member` and `forwarders`.\n",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
