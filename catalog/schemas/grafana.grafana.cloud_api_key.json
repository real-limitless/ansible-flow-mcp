{
  "fqcn": "grafana.grafana.cloud_api_key",
  "shortDescription": "Manage Grafana Cloud API keys",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/grafana/grafana/cloud_api_key_module.html",
  "options": [
    {
      "name": "existing_cloud_api_key",
      "displayName": "Existing Cloud Api Key",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Cloud API Key to authenticate with Grafana Cloud.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "fail_if_already_created",
      "displayName": "Fail If Already Created",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "If set to C(true), the task will fail if the API key with same name already exists in the Organization.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Sets the name of the Grafana Cloud API key.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "org_slug",
      "displayName": "Org Slug",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the Grafana Cloud organization in which Cloud API key will be created.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "role",
      "displayName": "Role",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Sets the role to be associated with the Cloud API key.",
      "choices": [
        "Admin",
        "Viewer",
        "Editor",
        "MetricsPublisher"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State for the Grafana Cloud API Key.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
