{
  "fqcn": "community.windows.win_scoop",
  "shortDescription": "Manage packages using Scoop",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/windows/win_scoop_module.html",
  "options": [
    {
      "name": "architecture",
      "displayName": "Architecture",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Force Scoop to install the package of a specific process architecture.",
      "choices": [
        "32bit",
        "64bit"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "global",
      "displayName": "Global",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Install the app globally",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "independent",
      "displayName": "Independent",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Don't install dependencies automatically",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "list",
      "required": true,
      "default": null,
      "description": "Name of the package(s) to be installed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "no_cache",
      "displayName": "No Cache",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Don't use the download cache",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "purge",
      "displayName": "Purge",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Remove all persistent data",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "skip_checksum",
      "displayName": "Skip Checksum",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Skip hash validation",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the package on the system. When C(absent), will ensure the package is not installed. When C(present), will ensure the package is installed.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
