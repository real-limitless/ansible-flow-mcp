{
  "fqcn": "ceph.automation.ceph_osd_flag",
  "shortDescription": "Manage Ceph OSD flag",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ceph/automation/ceph_osd_flag_module.html",
  "options": [
    {
      "name": "cluster",
      "displayName": "Cluster",
      "type": "string",
      "required": false,
      "default": "ceph",
      "description": "The ceph cluster name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "name of the ceph OSD flag.",
      "choices": [
        "noup",
        "nodown",
        "noout",
        "nobackfill",
        "norebalance",
        "norecover",
        "noscrub",
        "nodeep-scrub"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "If 'present' is used, the module sets the OSD flag. If 'absent' is used, the module will unset the OSD flag.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "user_key",
      "displayName": "User Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The ceph user key to use. If not set, the module will generate the name of the key based on the cluster name and user.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
