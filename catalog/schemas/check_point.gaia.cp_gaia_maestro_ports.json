      "required": false,
      "default": null,
      "description": "If true, Auto Negotiation will be turned on, and vice versa.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enabled",
      "displayName": "Enabled",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Setting this to false will disable this port, setting to true will enable it. AKA 'admin state'.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "id",
      "displayName": "Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Port ID (e.g. '1/13/1').",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "interface_name",
      "displayName": "Interface Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Interface name in case this port is an Uplink or MGMT interface (e.g. 'eth1-25').",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mtu",
      "displayName": "Mtu",
      "type": "number",
      "required": false,
      "default": null,
      "description": "MTU of this port.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "qsfp_mode",
