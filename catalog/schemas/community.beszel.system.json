{
  "fqcn": "community.beszel.system",
  "shortDescription": "Manage Beszel systems.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/beszel/system_module.html",
  "options": [
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": false,
      "default": null,
      "description": "IP address, FQDN or hostname of the Beszel system. Required when state is present.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the Beszel system.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Password used to authenticate to Beszel hub.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": 45876,
      "description": "Port of the Beszel system.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the Beszel system.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 120,
      "description": "Number of seconds to wait for the Beszel hub to respond.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "url",
      "displayName": "Url",
      "type": "string",
      "required": true,
      "default": null,
      "description": "URL of the Beszel hub.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Username used to authenticate to Beszel hub.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "users",
      "displayName": "Users",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of users to add to the Beszel system. If not provided, the current user specified in the username option will be added to the system.\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
