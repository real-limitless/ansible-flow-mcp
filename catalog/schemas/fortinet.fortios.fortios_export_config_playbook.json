{
  "fqcn": "fortinet.fortios.fortios_export_config_playbook",
  "shortDescription": "Collect the current configurations of the modules and convert then into playbooks.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/fortinet/fortios/fortios_export_config_playbook_module.html",
  "options": [
    {
      "name": "access_token",
      "displayName": "Access Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Token-based authentication. Generated from GUI of Fortigate.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enable_log",
      "displayName": "Enable Log",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable/Disable logging for task.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "filters",
      "displayName": "Filters",
      "type": "list",
      "required": false,
      "default": null,
      "description": "A list of expressions to filter the returned results. The items of the list are combined as LOGICAL AND with operator ampersand. One item itself could be concatenated with a comma as LOGICAL OR.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "formatters",
      "displayName": "Formatters",
      "type": "list",
      "required": false,
      "default": null,
      "description": "A list of fields to display for returned results.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "output_path",
      "displayName": "Output Path",
      "type": "string",
      "required": true,
      "default": null,
      "description": "the path used for saving the playbook.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "params",
      "displayName": "Params",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "the parameter for each selector, see definition in above list.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
