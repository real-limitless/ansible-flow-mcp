      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Display name of the NovaLink host.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password for the NovaLink host user.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ssh_key",
      "displayName": "Ssh Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Private key for authentication.",
      "choices": null,
      "noLog": true,
      "suboptions": null
