{
  "fqcn": "community.general.supervisorctl",
  "shortDescription": "Manage the state of a program or group of programs managed by C(supervisord)",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/supervisorctl_module.html",
  "options": [
    {
      "name": "config",
      "displayName": "Config",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The supervisor configuration file path.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the supervisord program or group to manage. The name is taken as group name when it ends with a colon V(:). If O(name=all), all programs and program groups are managed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password to use for authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server_url",
      "displayName": "Server Url",
      "type": "string",
      "required": false,
      "default": null,
      "description": "URL on which supervisord server is listening.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "signal",
      "displayName": "Signal",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The signal to send to the program/group, when combined with the V(signalled) state. Required when l(state=signalled).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The desired state of program/group.",
      "choices": [
        "present",
        "started",
        "stopped",
        "restarted",
        "absent",
        "signalled"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "stop_before_removing",
      "displayName": "Stop Before Removing",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Use O(stop_before_removing=true) to stop the program/group before removing it.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "supervisorctl_path",
      "displayName": "Supervisorctl Path",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Path to C(supervisorctl) executable.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Username to use for authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
