{
  "fqcn": "ibre5041.ansible_oracle_modules.oracle_audit",
  "shortDescription": "Manage Oracle Unified Auditing policies",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ibre5041/ansible_oracle_modules/oracle_audit_module.html",
  "options": [
    {
      "name": "audit_actions",
      "displayName": "Audit Actions",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of actions to audit (e.g. SELECT, INSERT, DELETE, UPDATE) Can include object-specific actions: SELECT ON schema.table",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "audit_condition",
      "displayName": "Audit Condition",
      "type": "string",
      "required": false,
      "default": null,
      "description": "A condition expression for conditional auditing (e.g. SYS_CONTEXT('USERENV','IP_ADDRESS') != '10.0.0.1')",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "audit_privileges",
      "displayName": "Audit Privileges",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of system privileges to audit (e.g. CREATE TABLE, ALTER USER, DROP ANY TABLE)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "audit_roles",
      "displayName": "Audit Roles",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of roles whose privileges should be audited",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "container",
      "displayName": "Container",
      "type": "string",
      "required": false,
      "default": "current",
      "description": "Container clause for multitenant",
      "choices": [
        "current",
        "all"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enabled_except_users",
      "displayName": "Enabled Except Users",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of users to exclude when enabling for all users",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enabled_users",
      "displayName": "Enabled Users",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of users to enable the policy for (empty list means all users) Use special value ALL for all users",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "evaluate_per",
      "displayName": "Evaluate Per",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Frequency of condition evaluation",
      "choices": [
        "statement",
        "session",
        "instance"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "policy_name",
      "displayName": "Policy Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the Unified Audit policy",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The intended state of the audit policy",
      "choices": [
        "present",
        "absent",
        "enabled",
        "disabled",
        "status"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
