      "default": "no",
      "description": "Set multicast optimization options",
      "choices": [
        "false",
        "no",
        "true",
        "yes"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Password for Cisco UCS Manager authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
