      "default": null,
      "description": "Port number to be used during connection (by default uses 443 for https and 80 for http connection).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "priority",
      "displayName": "Priority",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Priority to configure",
      "choices": [
        "best-effort",
        "bronze",
        "fc",
        "gold",
        "platinum",
        "silver"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "proxy",
      "displayName": "Proxy",
      "type": "string",
      "required": false,
      "default": null,
      "description": "If use_proxy is no, specfies proxy to be used for connection. e.g. 'http://proxy.xy.z:8080'",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "use_proxy",
      "displayName": "Use Proxy",
