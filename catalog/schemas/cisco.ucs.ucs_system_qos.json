      "required": false,
      "default": true,
      "description": "If C(no), will not use the proxy as defined by system environment variable.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "use_ssl",
      "displayName": "Use Ssl",
