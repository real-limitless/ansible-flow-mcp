      "displayName": "Username",
      "type": "string",
      "required": false,
      "default": "admin",
      "description": "Username for Cisco UCS Manager authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "weight",
      "displayName": "Weight",
      "type": "string",
      "required": true,
      "default": null,
      "description": "CoS profile weight. Choices are best-effort, none or 0-10.",
