      "displayName": "Admin State",
      "type": "string",
      "required": false,
      "default": "enabled",
      "description": "Admin state of QoS Policy",
      "choices": [
        "disabled",
        "enabled"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "cos",
      "displayName": "Cos",
      "type": "string",
      "required": true,
      "default": null,
      "description": "CoS setting. Choices are any or 0-6.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "drop",
      "displayName": "Drop",
      "type": "string",
      "required": false,
      "default": "drop",
      "description": "Set multicast optimization options",
      "choices": [
        "drop",
        "no-drop"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hostname",
      "displayName": "Hostname",
      "type": "string",
