{
  "fqcn": "cisco.ucs.ucs_system_qos",
  "shortDescription": "Configures system QoS settings",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/cisco/ucs/ucs_system_qos_module.html",
  "options": [
