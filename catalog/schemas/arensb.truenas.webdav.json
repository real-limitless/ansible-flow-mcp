{
  "fqcn": "arensb.truenas.webdav",
  "shortDescription": "Configure the WebDAV service",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/arensb/truenas/webdav_module.html",
  "options": [
    {
      "name": "auth_type",
      "displayName": "Auth Type",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Authentication type.",
      "choices": [
        "NONE",
        "BASIC",
        "DIGEST"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "certssl",
      "displayName": "Certssl",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The name of the certificate to use for HTTPS. Use the C(certificate) module to install a certificate.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "WebDAV password, as a plaintext string.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": null,
      "description": "TCP port on which the HTTP service listens.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "portssl",
      "displayName": "Portssl",
      "type": "number",
      "required": false,
      "default": null,
      "description": "TCP port on which the HTTPS service listens.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "protocol",
      "displayName": "Protocol",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Protocol to use to connect to the WebDAV service. The value \"HTTPHTTPS\" allows connecting using either HTTP or HTTPS.",
      "choices": [
        "HTTP",
        "HTTPS",
        "HTTPHTTPS"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
