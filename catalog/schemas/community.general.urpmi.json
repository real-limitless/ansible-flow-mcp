{
  "fqcn": "community.general.urpmi",
  "shortDescription": "Urpmi manager",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/urpmi_module.html",
  "options": [
    {
      "name": "force",
      "displayName": "Force",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Assume \"yes\" is the answer to any question urpmi has to ask. Corresponds to the C(--force) option for C(urpmi).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "list",
      "required": true,
      "default": null,
      "description": "A list of package names to install, upgrade or remove.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "no_recommends",
      "displayName": "No Recommends",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Corresponds to the C(--no-recommends) option for C(urpmi).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "root",
      "displayName": "Root",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies an alternative install root, relative to which all packages are installed. Corresponds to the C(--root) option for C(urpmi).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Indicates the desired package state.",
      "choices": [
        "absent",
        "present",
        "installed",
        "removed"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "update_cache",
      "displayName": "Update Cache",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Update the package database first C(urpmi.update -a).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
