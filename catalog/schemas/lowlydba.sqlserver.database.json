{
  "fqcn": "lowlydba.sqlserver.database",
  "shortDescription": "Creates and configures a database",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/lowlydba/sqlserver/database_module.html",
  "options": [
    {
      "name": "compatibility",
      "displayName": "Compatibility",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Compatibility mode for the database. Follows the format of C(Version90), C(Version100), and so on. String is validated by C(Set-DbaDbCompatibility).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "data_file_path",
      "displayName": "Data File Path",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Directory where the data files should be placed. Uses SQL Server's default if not supplied. Only used if database is being created.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "database",
      "displayName": "Database",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the target database.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "log_file_path",
      "displayName": "Log File Path",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Directory where the log files should be placed. Uses SQL Server's default if not supplied. Only used if database is being created.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "maxdop",
      "displayName": "Maxdop",
      "type": "number",
      "required": false,
      "default": null,
      "description": "MAXDOP value for the database.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "only_accessible",
      "displayName": "Only Accessible",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether or not to enable Read Committed Snapshot Isolation.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "owner",
      "displayName": "Owner",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Database owner login.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "rcsi",
      "displayName": "Rcsi",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Whether or not to enable Read Committed Snapshot Isolation.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "recovery_model",
      "displayName": "Recovery Model",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Choose the recovery model for the database.",
      "choices": [
        "Full",
        "Simple",
        "BulkLogged"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "secondary_maxdop",
      "displayName": "Secondary Maxdop",
      "type": "number",
      "required": false,
      "default": null,
      "description": "MAXDOP value for the database when it is a non-primary replica in an availability group.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "sql_instance",
      "displayName": "Sql Instance",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The SQL Server instance to modify.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "sql_password",
      "displayName": "Sql Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password for SQL Authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "sql_username",
      "displayName": "Sql Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Username for SQL Authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether or not the object should be C(present) or C(absent).",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
