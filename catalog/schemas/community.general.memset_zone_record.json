{
  "fqcn": "community.general.memset_zone_record",
  "shortDescription": "Create and delete records in Memset DNS zones",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/memset_zone_record_module.html",
  "options": [
    {
      "name": "address",
      "displayName": "Address",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The address for this record (can be IP or text string depending on record type).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_key",
      "displayName": "Api Key",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The API key obtained from the Memset control panel.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "priority",
      "displayName": "Priority",
      "type": "number",
      "required": false,
      "default": 0,
      "description": "C(SRV) and C(TXT) record priority, in the range 0 > 999 (inclusive).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "record",
      "displayName": "Record",
      "type": "string",
      "required": false,
      "default": "",
      "description": "The subdomain to create.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "relative",
      "displayName": "Relative",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If set then the current domain is added onto the address field for C(CNAME), C(MX), C(NS) and C(SRV)record types.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Indicates desired state of resource.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ttl",
      "displayName": "Ttl",
      "type": "number",
      "required": false,
      "default": 0,
      "description": "The record's TTL in seconds (will inherit zone's TTL if not explicitly set). This must be a valid int from U(https://www.memset.com/apidocs/methods_dns.html#dns.zone_record_create).",
      "choices": [
        0,
        300,
        600,
        900,
        1800,
        3600,
        7200,
        10800,
        21600,
        43200,
        86400
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "type",
      "displayName": "Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The type of DNS record to create.",
      "choices": [
        "A",
        "AAAA",
        "CNAME",
        "MX",
        "NS",
        "SRV",
        "TXT"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone",
      "displayName": "Zone",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the zone to which to add the record to.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
