  "options": [
    {
      "name": "msg",
      "displayName": "Msg",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The message to log",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "severity",
      "displayName": "Severity",
      "type": "string",
      "required": false,
      "default": "DEBUG",
