{
  "fqcn": "h3c_open.comware.comware_log",
  "shortDescription": "get the device diagnostic information and upload to file server",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/h3c_open/comware/comware_log_module.html",
  "options": [
    {
      "name": "diag_dir",
      "displayName": "Diag Dir",
      "type": "string",
      "required": false,
      "default": "flash:/",
      "description": "where the device diagnostic information storage , default is flash:/",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dst_dir",
      "displayName": "Dst Dir",
      "type": "string",
      "required": false,
      "default": null,
      "description": "remote dir where the file save.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ftpupload",
      "displayName": "Ftpupload",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "whether upload the diagnostic information to the service.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server_hostname",
      "displayName": "Server Hostname",
      "type": "string",
      "required": false,
      "default": null,
      "description": "the remote server hostname e.g.192.168.1.199.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server_name",
      "displayName": "Server Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "the name to login in remote server.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server_pwd",
      "displayName": "Server Pwd",
      "type": "string",
      "required": false,
      "default": null,
      "description": "the password to login in remote server.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "servertype",
      "displayName": "Servertype",
      "type": "string",
      "required": false,
      "default": null,
      "description": "choose the diagnostic file upload server type.",
      "choices": [
        "ftp",
        "scp"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "service_dir",
      "displayName": "Service Dir",
      "type": "string",
      "required": false,
      "default": null,
      "description": "the dir in server which you want to upload the diag file from device",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The state of operation",
      "choices": [
        "present",
        "default",
        "loadtoserver"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
