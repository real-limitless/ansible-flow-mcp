{
  "fqcn": "community.general.opkg",
  "shortDescription": "Package manager for OpenWrt and Openembedded/Yocto based Linux distributions",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/opkg_module.html",
  "options": [
    {
      "name": "executable",
      "displayName": "Executable",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The executable location for C(opkg).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "force",
      "displayName": "Force",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The C(opkg --force) parameter used.",
      "choices": [
        "depends",
        "maintainer",
        "reinstall",
        "overwrite",
        "downgrade",
        "space",
        "postinstall",
        "remove",
        "checksum",
        "removal-of-dependent-packages"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "list",
      "required": true,
      "default": null,
      "description": "Name of package(s) to install/remove. V(NAME=VERSION) syntax is also supported to install a package in a certain version. See the examples. This only works on Yocto based Linux distributions (opkg>=0.3.2) and not for OpenWrt. This is supported since community.general 6.2.0.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the package.",
      "choices": [
        "present",
        "absent",
        "installed",
        "removed"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "update_cache",
      "displayName": "Update Cache",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Update the package DB first.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
