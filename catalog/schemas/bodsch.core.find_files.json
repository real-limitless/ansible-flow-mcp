{
  "fqcn": "bodsch.core.find_files",
  "shortDescription": "Collect file status information for multiple paths",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/bodsch/core/find_files_module.html",
  "options": [
    {
      "name": "checksum_algorithm",
      "displayName": "Checksum Algorithm",
      "type": "string",
      "required": false,
      "default": "sha256",
      "description": "Hash algorithm used when C(get_checksum=true).",
      "choices": [
        "sha1",
        "sha224",
        "sha256",
        "sha384",
        "sha512"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "file_list",
      "displayName": "File List",
      "type": "list",
      "required": true,
      "default": null,
      "description": "List of file system paths to inspect.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "follow",
      "displayName": "Follow",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Follow symbolic links instead of returning information about the link itself.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "get_checksum",
      "displayName": "Get Checksum",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Calculate a checksum for regular files. Checksums are only returned for existing regular files.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
