{
  "fqcn": "h3c_open.comware.comware_netconf",
  "shortDescription": "Manage netconf log and xml function on Comware 7 devices.XML cfg not support enter xml view now, This is not normally done.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/h3c_open/comware/comware_netconf_module.html",
  "options": [
    {
      "name": "opera_type",
      "displayName": "Opera Type",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Protocol-operation option.",
      "choices": [
        "all",
        "action",
        "config",
        "get",
        "session",
        "set",
        "syntax",
        "others"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "operation",
      "displayName": "Operation",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Netconf operation option.If you chose protocol-operation,the opera_type option must be config.",
      "choices": [
        "protocol-operation",
        "row-operation",
        "verbose"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "soap",
      "displayName": "Soap",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Desired state for the interface configuration",
      "choices": [
        "http",
        "https"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "source",
      "displayName": "Source",
      "type": "string",
      "required": false,
      "default": null,
      "description": "NETCONF operation source requiring log output.Option 'all' means all source.",
      "choices": [
        "all",
        "agent",
        "soap",
        "web"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired state for the interface configuration",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
