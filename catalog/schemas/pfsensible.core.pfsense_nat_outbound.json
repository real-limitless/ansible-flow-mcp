{
  "fqcn": "pfsensible.core.pfsense_nat_outbound",
  "shortDescription": "Manage pfSense Outbound NAT (SNAT) rules",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/pfsensible/core/pfsense_nat_outbound_module.html",
  "options": [
    {
      "name": "address",
      "displayName": "Address",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The translated to address, in {ALIAS,NETWORK}[:port] format. Leave address part empty to use interface address.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "after",
      "displayName": "After",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Rule to go after, or \"top\"",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "before",
      "displayName": "Before",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Rule to go before, or \"bottom\"",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "descr",
      "displayName": "Descr",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the nat rule",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "destination",
      "displayName": "Destination",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The matching destination address, in {any,ALIAS,NETWORK,NET:INTERFACE}[:port] format.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "disabled",
      "displayName": "Disabled",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Is the rule disabled",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "interface",
      "displayName": "Interface",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The interface for the rule",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "invert",
      "displayName": "Invert",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Invert the sense of the destination match.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ipprotocol",
      "displayName": "Ipprotocol",
      "type": "string",
      "required": false,
      "default": "inet46",
      "description": "The Internet Protocol version this rule applies to.",
      "choices": [
        "inet",
        "inet46",
        "inet6"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "nonat",
      "displayName": "Nonat",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "This option will disable NAT for traffic matching this rule and stop processing Outbound NAT rules",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "nosync",
      "displayName": "Nosync",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Prevents the rule on Master from automatically syncing to other CARP members. This does NOT prevent the rule from being overwritten on Slave.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "poolopts",
      "displayName": "Poolopts",
      "type": "string",
      "required": false,
      "default": "",
      "description": "When an address pool is used, there are several options available that control how NAT translations happen on the pool.",
      "choices": [
        "",
        "round-robin",
        "round-robin sticky-address",
        "random",
        "random sticky-address",
        "source-hash",
        "bitmask"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "protocol",
      "displayName": "Protocol",
      "type": "string",
      "required": false,
      "default": "any",
      "description": "Which protocol this rule should match.",
      "choices": [
        "any",
        "tcp",
        "udp",
        "tcp/udp",
        "icmp",
        "esp",
        "ah",
        "gre",
        "ipv6",
        "igmp",
        "carp",
        "pfsync"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "source",
      "displayName": "Source",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The matching source address, in {any,(self),ALIAS,NETWORK,NET:INTERFACE}[:port] format.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "source_hash_key",
      "displayName": "Source Hash Key",
      "type": "string",
      "required": false,
      "default": "",
      "description": "The key that is fed to the hashing algorithm in hex format, preceeded by \"0x\", or any string. A non-hex string is hashed using md5 to a hexadecimal key. Defaults to a randomly generated value.\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State in which to leave the rule",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "staticnatport",
      "displayName": "Staticnatport",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Do not randomize source port",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
