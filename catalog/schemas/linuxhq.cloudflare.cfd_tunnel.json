      "noLog": false,
      "suboptions": null
    },
    {
      "name": "tunnel_secret",
      "displayName": "Tunnel Secret",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Tunnel secret for locally-managed tunnels. Applied when creating a tunnel. Cloudflare does not return the current secret, so changes are not detected; use C(rotate_secrets) to apply the secret to an existing tunnel.",
