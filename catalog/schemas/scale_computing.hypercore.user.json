  "options": [
    {
      "name": "cluster_instance",
      "displayName": "Cluster Instance",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "Scale Computing HyperCore instance information.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "full_name",
      "displayName": "Full Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Human-readable display name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Plain text password for authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "roles",
      "displayName": "Roles",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Names of the roles this user is a member of.",
      "choices": [
        "Backup",
        "VM Delete",
        "Cluster Settings",
        "Cluster Shutdown",
        "VM Power Controls",
        "Read",
        "VM Create/Edit",
        "Admin"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "session_limit",
      "displayName": "Session Limit",
      "type": "number",
      "required": false,
      "default": null,
      "description": "The maximum number of Sessions this user may have at one time.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The desired state of the user account. Use C(absent) to ensure the user will be absent from the API and C(present) to ensure user will remain present on the API.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The user name. Serves as unique identifier. If C(state) is I(present) and C(username) doesn't exist, a new user is created. If C(state) is I(present) and C(username) already exists, existing user is updated. If C(state) is I(absent) and C(username) is found, existing user is deleted.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username_new",
      "displayName": "Username New",
      "type": "string",
      "required": false,
      "default": null,
      "description": "New user name. Relevant only if C(state) is I(present) and C(username) exists.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
