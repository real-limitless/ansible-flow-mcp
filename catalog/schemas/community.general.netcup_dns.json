{
  "fqcn": "community.general.netcup_dns",
  "shortDescription": "Manage Netcup DNS records",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/netcup_dns_module.html",
  "options": [
    {
      "name": "api_key",
      "displayName": "Api Key",
      "type": "string",
      "required": true,
      "default": null,
      "description": "API key for authentication, must be obtained using the netcup CCP (U(https://ccp.netcup.net)).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_password",
      "displayName": "Api Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "API password for authentication, must be obtained using the netcup CCP (U(https://ccp.netcup.net)).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "customer_id",
      "displayName": "Customer Id",
      "type": "number",
      "required": true,
      "default": null,
      "description": "Netcup customer ID.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "domain",
      "displayName": "Domain",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Domainname the records should be added / removed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "priority",
      "displayName": "Priority",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Record priority. Required for O(type=MX).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "record",
      "displayName": "Record",
      "type": "string",
      "required": false,
      "default": "@",
      "description": "Record to add or delete, supports wildcard (V(*)). Default is V(@) (that is, the zone name).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "solo",
      "displayName": "Solo",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether the record should be the only one for that record type and record name. Only use with O(state=present). This deletes all other records with the same record name and type.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the record should exist or not.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 5,
      "description": "HTTP(S) connection timeout in seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "type",
      "displayName": "Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Record type. Support for V(OPENPGPKEY), V(SMIMEA) and V(SSHFP) was added in community.general 8.1.0. Record types V(OPENPGPKEY) and V(SMIMEA) require nc-dnsapi >= 0.1.5. Record type V(SSHFP) requires nc-dnsapi >= 0.1.6.",
      "choices": [
        "A",
        "AAAA",
        "MX",
        "CNAME",
        "CAA",
        "SRV",
        "TXT",
        "TLSA",
        "NS",
        "DS",
        "OPENPGPKEY",
        "SMIMEA",
        "SSHFP"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "value",
      "displayName": "Value",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Record value.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
