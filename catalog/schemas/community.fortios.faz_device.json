      "description": "The IP of the device being added to FortiAnalyzer.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "device_password",
      "displayName": "Device Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The password of the device being added to FortiAnalyzer.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "device_serial",
      "displayName": "Device Serial",
      "type": "string",
      "required": false,
