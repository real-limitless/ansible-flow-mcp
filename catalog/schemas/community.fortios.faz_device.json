      "description": "Minor OS rev of the device.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "os_type",
      "displayName": "Os Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The os type of the device being added (default 0).",
      "choices": [
        "unknown",
        "fos",
        "fsw",
        "foc",
        "fml",
