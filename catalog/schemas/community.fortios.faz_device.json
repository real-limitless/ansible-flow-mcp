      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "device_username",
      "displayName": "Device Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The username of the device being added to FortiAnalyzer.",
      "choices": null,
      "noLog": false,
      "suboptions": null
