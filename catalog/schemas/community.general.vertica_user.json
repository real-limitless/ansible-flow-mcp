{
  "fqcn": "community.general.vertica_user",
  "shortDescription": "Adds or removes Vertica database users and assigns roles",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/vertica_user_module.html",
  "options": [
    {
      "name": "cluster",
      "displayName": "Cluster",
      "type": "string",
      "required": false,
      "default": "localhost",
      "description": "Name of the Vertica cluster.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "db",
      "displayName": "Db",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Name of the Vertica database.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "expired",
      "displayName": "Expired",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Sets the user's password expiration.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ldap",
      "displayName": "Ldap",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Set to V(true) if users are authenticated using LDAP. The user is created with password expired and set to V($ldap$).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_password",
      "displayName": "Login Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The password used to authenticate with.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_user",
      "displayName": "Login User",
      "type": "string",
      "required": false,
      "default": "dbadmin",
      "description": "The username used to authenticate with.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The user's password encrypted by the MD5 algorithm. The password must be generated with the format C(\"md5\" + md5[password + username]), resulting in a total of 35 characters. An easy way to do this is by querying the Vertica database with select V('md5'|| md5('<user_password><user_name>'\\)).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "string",
      "required": false,
      "default": "5433",
      "description": "Vertica cluster port to connect to.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "profile",
      "displayName": "Profile",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Sets the user's profile.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "resource_pool",
      "displayName": "Resource Pool",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Sets the user's resource pool.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "roles",
      "displayName": "Roles",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Comma separated list of roles to assign to the user.",
      "choices": null,
      "noLog": false,
      "suboptions": null
