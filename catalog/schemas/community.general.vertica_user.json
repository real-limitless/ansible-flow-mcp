    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether to create (V(present)), drop (V(absent)), or lock (V(locked)) a user.",
      "choices": [
        "present",
        "absent",
        "locked"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "user",
      "displayName": "User",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the user to add or remove.",
      "choices": null,
      "noLog": false,
      "suboptions": null
