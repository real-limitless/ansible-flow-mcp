      "default": "absent",
      "description": "The switch of backup",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "filefolder",
      "displayName": "Filefolder",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Full specified backup path on Comware v7 device, e.g. flash:/mypath/.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "filename",
      "displayName": "Filename",
      "type": "string",
      "required": false,
      "default": "my_file",
      "description": "Backup file",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "replacefile",
      "displayName": "Replacefile",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Rolling file",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "repswitch",
      "displayName": "Repswitch",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Configure rollback switch",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "y_or_no",
      "displayName": "Y Or No",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Configure the switch to save the current configuration during rollback.",
      "choices": [
        "y",
        "n"
      ],
      "noLog": false,
      "suboptions": null
    }
