{
  "fqcn": "sva.sentinelone.sites",
  "shortDescription": "Manage SentinelOne Sites",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/sva/sentinelone/sites_module.html",
  "options": [
    {
      "name": "console_url",
      "displayName": "Console Url",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Insert your management console URL",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Description for the site",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "expiration_date",
      "displayName": "Expiration Date",
      "type": "string",
      "required": false,
      "default": "-1",
      "description": "Sets the expiration date Use B(-1) (default) to set to B(max expiration) available. This is either unlimited or account expiration date. Format is ISO 8601 without microseconds Examples: 2022-03-15T10:20+00:00 2022-03-15T11:21+0100",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "license_type",
      "displayName": "License Type",
      "type": "string",
      "required": false,
      "default": "core",
      "description": "The SKU to use",
      "choices": [
        "core",
        "control",
        "complete"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the site",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "site_type",
      "displayName": "Site Type",
      "type": "string",
      "required": false,
      "default": "Paid",
      "description": "The type of the site",
      "choices": [
        "Trial",
        "Paid"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Select the state of the site",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "token",
      "displayName": "Token",
      "type": "string",
      "required": true,
      "default": null,
      "description": "SentinelOne API auth token to authenticate at the management API",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "total_agents",
      "displayName": "Total Agents",
      "type": "number",
      "required": false,
      "default": -1,
      "description": "Count of total agent licenses to be assigned to site Use B(-1) (default) to set to B(unlimited licenses) in site",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
