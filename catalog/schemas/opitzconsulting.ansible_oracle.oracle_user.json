{
  "fqcn": "opitzconsulting.ansible_oracle.oracle_user",
  "shortDescription": "Manage users/schemas in an Oracle database",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/opitzconsulting/ansible_oracle/oracle_user_module.html",
  "options": [
    {
      "name": "authentication_type",
      "displayName": "Authentication Type",
      "type": "string",
      "required": false,
      "default": "password",
      "description": "The type of authentication for the user.",
      "choices": [
        "password",
        "external",
        "global"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "default_tablespace",
      "displayName": "Default Tablespace",
      "type": "string",
      "required": false,
      "default": "None",
      "description": "The default tablespace for the new schema. The tablespace must exist\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "default_temp_tablespace",
      "displayName": "Default Temp Tablespace",
      "type": "string",
      "required": false,
      "default": "None",
      "description": "The default tablespace for the new schema. The tablespace must exist\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "grants",
      "displayName": "Grants",
      "type": "string",
      "required": false,
      "default": "None",
      "description": "The privileges granted to the new schema",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hostname",
      "displayName": "Hostname",
      "type": "string",
      "required": false,
      "default": "localhost",
      "description": "The Oracle database host",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mode",
      "displayName": "Mode",
      "type": "string",
      "required": false,
      "default": "normal",
      "description": "The mode with which to connect to the database",
      "choices": [
        "normal",
        "sysdba"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The Oracle user password for 'user'",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "string",
      "required": false,
      "default": 1521,
      "description": "The listener port number on the host",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "profile",
      "displayName": "Profile",
      "type": "string",
      "required": false,
      "default": "None",
      "description": "The profile for the user",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "schema",
      "displayName": "Schema",
      "type": "string",
      "required": false,
      "default": "None",
      "description": "The schema that you want to manage",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "schema_password",
      "displayName": "Schema Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The password for the new schema. i.e '..identified by password'",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "schema_password_hash",
      "displayName": "Schema Password Hash",
      "type": "string",
      "required": false,
      "default": "None",
      "description": "The password hash for the new schema. i.e '..identified by values 'XXXXXXX'\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "service_name",
      "displayName": "Service Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The database service name to connect to",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the user should exist. Absent removes the user, locked/unlocked locks or unlocks the user\n",
      "choices": [
        "present",
        "absent",
        "locked",
        "unlocked"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "update_password",
      "displayName": "Update Password",
      "type": "string",
      "required": false,
      "default": "always",
      "description": "always will update passwords if they differ. on_create will only set the password for newly created users.\n",
      "choices": [
        "always",
        "on_create"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "user",
      "displayName": "User",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The Oracle user name to connect to the database",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
