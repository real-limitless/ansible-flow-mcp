{
  "fqcn": "jfrancis42.netgear.maintenance",
  "shortDescription": "Perform maintenance operations on a Netgear Smart Managed Plus switch",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/jfrancis42/netgear/maintenance_module.html",
  "options": [
    {
      "name": "action",
      "displayName": "Action",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Maintenance action to perform.",
      "choices": [
        "reboot",
        "factory_reset",
        "cable_diag"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "force",
      "displayName": "Force",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Required to be C(true) for C(action=factory_reset) as a safety guard. A factory reset erases all configuration and resets the switch IP to its factory default.\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Switch management IP or hostname.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Login password.",
      "choices": null,
      "noLog": true,
      "suboptions": null
    },
    {
      "name": "ports",
      "displayName": "Ports",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Port numbers to run cable diagnostics on (1-based). If omitted, all ports are tested.  Used with C(action=cable_diag).\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 10.0,
      "description": "HTTP request timeout in seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
