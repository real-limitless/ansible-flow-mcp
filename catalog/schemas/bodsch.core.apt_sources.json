{
  "fqcn": "bodsch.core.apt_sources",
  "shortDescription": "Manage APT deb822 (.sources) repositories with repo-specific keyrings.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/bodsch/core/apt_sources_module.html",
  "options": [
    {
      "name": "architectures",
      "displayName": "Architectures",
      "type": "list",
      "required": false,
      "default": [],
      "description": "Restrict repository to architectures (e.g. amd64).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "components",
      "displayName": "Components",
      "type": "list",
      "required": false,
      "default": [],
      "description": "Components (e.g. main, contrib). Required unless suite is a path ending in '/'.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dest",
      "displayName": "Dest",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Full path of the .sources file. If omitted, computed from filename/name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enabled",
      "displayName": "Enabled",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether the source is enabled (Enabled: yes/no).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "filename",
      "displayName": "Filename",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Filename under /etc/apt/sources.list.d/ (must end with .sources).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "key",
      "displayName": "Key",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "Key import configuration.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Logical name of the repository (used for defaults like filename).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "signed_by",
      "displayName": "Signed By",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Absolute path to a keyring file used as Signed-By. If omitted and key.method is download/deb, derived from key config.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the repository should be present or absent.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "suites",
      "displayName": "Suites",
      "type": "list",
      "required": true,
      "default": null,
      "description": "Suites / distributions (e.g. bookworm). If suite ends with '/', Components must be omitted.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "types",
      "displayName": "Types",
      "type": "list",
      "required": false,
      "default": [
        "deb"
      ],
      "description": "Repository types (deb, deb-src).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "update_cache",
      "displayName": "Update Cache",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Run apt-get update if repo/key changed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "uris",
      "displayName": "Uris",
      "type": "list",
      "required": true,
      "default": null,
      "description": "Base URIs of the repository.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
