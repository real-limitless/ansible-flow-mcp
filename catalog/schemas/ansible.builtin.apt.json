      "default": false,
      "description": "Run apt update.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "cache_valid_time",
      "displayName": "Cache Valid Time",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Update cache if older than N seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pkg",
      "displayName": "Pkg",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Alias for name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
