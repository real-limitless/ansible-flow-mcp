{
  "fqcn": "ansible.builtin.apt",
  "shortDescription": "Manage apt packages (Debian/Ubuntu).",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ansible/builtin/apt_module.html",
  "options": [
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Package name(s).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "",
      "choices": [
        "absent",
        "build-dep",
        "latest",
        "present",
        "fixed"
      ],
      "noLog": false,
      "suboptions": null
