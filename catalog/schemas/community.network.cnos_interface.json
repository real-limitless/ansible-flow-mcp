      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "speed",
      "displayName": "Speed",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Interface link speed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
