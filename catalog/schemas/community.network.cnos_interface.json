      "choices": [
        "present",
        "absent",
        "up",
        "down"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "tx_rate",
      "displayName": "Tx Rate",
      "type": "string",
      "required": false,
      "default": null,
