      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the Interface.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "neighbors",
      "displayName": "Neighbors",
      "type": "string",
      "required": false,
      "default": null,
