      "choices": [
        "full",
        "half",
        "auto"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enabled",
      "displayName": "Enabled",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Interface link status.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
