{
  "fqcn": "community.routeros.api_info",
  "shortDescription": "Retrieve information from API",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/routeros/api_info_module.html",
  "options": [
    {
      "name": "ca_path",
      "displayName": "Ca Path",
      "type": "string",
      "required": false,
      "default": null,
      "description": "PEM formatted file that contains a CA certificate to be used for certificate validation. See also O(validate_cert_hostname). Only used when O(tls=true) and O(validate_certs=true).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "encoding",
      "displayName": "Encoding",
      "type": "string",
      "required": false,
      "default": "ASCII",
      "description": "Use the specified encoding when communicating with the RouterOS device. Default is V(ASCII). Note that V(UTF-8) requires librouteros 3.2.1 or newer.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "force_no_cert",
      "displayName": "Force No Cert",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Set to V(true) to connect without a certificate when O(tls=true). See also O(validate_certs). B(Note:) this forces the use of anonymous Diffie-Hellman (ADH) ciphers. The protocol is susceptible to Man-in-the-Middle attacks, because the keys used in the exchange are not authenticated. Instead of simply connecting without a certificate to \"make things work\" have a look at O(validate_certs) and O(ca_path).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "handle_disabled",
      "displayName": "Handle Disabled",
      "type": "string",
      "required": false,
      "default": "exclamation",
      "description": "How to handle unset values. V(exclamation) prepends the keys with V(!) in the output with value V(null). V(null-value) uses the regular key with value V(null). V(omit) omits these values from the result.",
      "choices": [
        "exclamation",
        "null-value",
        "omit"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hide_defaults",
      "displayName": "Hide Defaults",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether to hide default values.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hostname",
      "displayName": "Hostname",
      "type": "string",
      "required": true,
      "default": null,
      "description": "RouterOS hostname API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "include_builtin",
      "displayName": "Include Builtin",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether to include builtin values. By default, they are not returned, and the C(builtin) keys are omitted. If set to V(true), they are returned as well, and the C(builtin) keys are returned as well.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "include_dynamic",
      "displayName": "Include Dynamic",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether to include dynamic values. By default, they are not returned, and the C(dynamic) keys are omitted. If set to V(true), they are returned as well, and the C(dynamic) keys are returned as well.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "include_read_only",
      "displayName": "Include Read Only",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether to include read-only fields. By default, they are not returned.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
