{
  "fqcn": "dellemc.powerscale.alert_rule",
  "shortDescription": "Manage alert rule on a PowerScale Storage System",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/dellemc/powerscale/alert_rule_module.html",
  "options": [
    {
      "name": "api_password",
      "displayName": "Api Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "the password of the PowerScale cluster.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_user",
      "displayName": "Api User",
      "type": "string",
      "required": true,
      "default": null,
      "description": "username of the PowerScale cluster.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "categories",
      "displayName": "Categories",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Event group categories to be alerted.",
      "choices": [
        "all",
        "SYS_DISK_EVENTS",
        "NODE_STATUS_EVENTS",
        "REBOOT_EVENTS",
        "SW_EVENTS",
        "QUOTA_EVENTS",
        "SNAP_EVENTS",
        "WINNET_EVENTS",
        "FILESYS_EVENTS",
        "HW_EVENTS",
        "CPOOL_EVENTS"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "channels",
      "displayName": "Channels",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Channels for the alert. This is option is required for create alert condition.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "condition",
      "displayName": "Condition",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Trigger condition for alert.",
      "choices": [
        "NEW",
        "NEW EVENTS",
        "ONGOING",
        "SEVERITY INCREASE",
        "SEVERITY DECREASE",
        "RESOLVED"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "eventgroup_ids",
      "displayName": "Eventgroup Ids",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Event group ID is to be alerted.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "exclude_eventgroup_ids",
      "displayName": "Exclude Eventgroup Ids",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Event group categories to be excluded from alerts.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "interval",
      "displayName": "Interval",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Required with C(ONGOING) condition only, period in seconds between alerts of ongoing conditions.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "limit",
      "displayName": "Limit",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Required with C(NEW EVENTS) condition only, limits the number of alerts sent as events are added.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The I(name) of the rule is a unique that cannot be changed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "onefs_host",
      "displayName": "Onefs Host",
      "type": "string",
      "required": true,
      "default": null,
      "description": "IP address or FQDN of the PowerScale cluster.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port_no",
      "displayName": "Port No",
      "type": "string",
      "required": false,
      "default": "8080",
      "description": "Port number of the PowerScale cluster.It defaults to 8080 if not specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "severities",
      "displayName": "Severities",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Severities to be alerted.",
      "choices": [
        "emergency",
        "critical",
        "warning",
        "information"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The state option is used to mention the existence of server certificate.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "transient",
      "displayName": "Transient",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Any event group lasting less than this many seconds is deemed transient and will not generate alerts under this condition.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "verify_ssl",
      "displayName": "Verify Ssl",
      "type": "boolean",
      "required": true,
      "default": null,
      "description": "boolean variable to specify whether to validate SSL certificate or not. C(true) - indicates that the SSL certificate should be verified. C(false) - indicates that the SSL certificate should not be verified.",
      "choices": [
        true,
        false
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
