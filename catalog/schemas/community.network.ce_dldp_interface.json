{
  "fqcn": "community.network.ce_dldp_interface",
  "shortDescription": "Manages interface DLDP configuration on HUAWEI CloudEngine switches.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/network/ce_dldp_interface_module.html",
  "options": [
    {
      "name": "enable",
      "displayName": "Enable",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Set interface DLDP enable state.",
      "choices": [
        "enable",
        "disable"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "interface",
      "displayName": "Interface",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Must be fully qualified interface name, i.e. GE1/0/1, 10GE1/0/1, 40GE1/0/22, 100GE1/0/1.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "local_mac",
      "displayName": "Local Mac",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Set the source MAC address for DLDP packets sent in the DLDP-compatible mode. The value of MAC address is in H-H-H format. H contains 1 to 4 hexadecimal digits.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mode_enable",
      "displayName": "Mode Enable",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Set DLDP compatible-mode enable state.",
      "choices": [
        "enable",
        "disable"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "reset",
      "displayName": "Reset",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specify whether reseting interface DLDP state.",
      "choices": [
        "enable",
        "disable"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Manage the state of the resource.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
