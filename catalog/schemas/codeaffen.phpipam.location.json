      "default": null,
      "description": "Address of the given location if I(resolv_location) is set to True, this address will be used to resolve the latitude and longitude Mutually exclusive with latitude and longitude",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "app_id",
      "displayName": "App Id",
      "type": "string",
