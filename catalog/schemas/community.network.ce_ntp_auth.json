{
  "fqcn": "community.network.ce_ntp_auth",
  "shortDescription": "Manages NTP authentication configuration on HUAWEI CloudEngine switches.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/network/ce_ntp_auth_module.html",
  "options": [
    {
      "name": "auth_mode",
      "displayName": "Auth Mode",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specify authentication algorithm.",
      "choices": [
        "hmac-sha256",
        "md5"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_pwd",
      "displayName": "Auth Pwd",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Plain text with length of 1 to 255, encrypted text with length of 20 to 392.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_type",
      "displayName": "Auth Type",
      "type": "string",
      "required": false,
      "default": "encrypt",
      "description": "Whether the given password is in cleartext or has been encrypted. If in cleartext, the device will encrypt it before storing it.",
      "choices": [
        "text",
        "encrypt"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "authentication",
      "displayName": "Authentication",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Configure ntp authentication enable or unconfigure ntp authentication enable.",
      "choices": [
        "enable",
        "disable"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "key_id",
      "displayName": "Key Id",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Authentication key identifier (numeric).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Manage the state of the resource.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "trusted_key",
      "displayName": "Trusted Key",
      "type": "string",
      "required": false,
      "default": "disable",
      "description": "Whether the given key is required to be supplied by a time source for the device to synchronize to the time source.",
      "choices": [
        "enable",
        "disable"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
