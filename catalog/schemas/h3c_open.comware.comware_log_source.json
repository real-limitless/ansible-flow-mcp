{
  "fqcn": "h3c_open.comware.comware_log_source",
  "shortDescription": "Manage output rules for log information on V7 devices",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/h3c_open/comware/comware_log_source_module.html",
  "options": [
    {
      "name": "channelID",
      "displayName": "Channelid",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Specifies syslog output destination",
      "choices": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "channelName",
      "displayName": "Channelname",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Specifies a module by its name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "level",
      "displayName": "Level",
      "type": "string",
      "required": false,
      "default": null,
      "description": "A log output rule specifies the source modules and severity level of logs that can be output to a destination. Logs matching the output rule are output to the destination.",
      "choices": [
        "emergency",
        "alert",
        "critical",
        "error",
        "warning",
        "notification",
        "informational",
        "debugging",
        "deny"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired state of the switchport",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
