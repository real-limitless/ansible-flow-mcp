      "displayName": "Zone",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the primary zone to sign",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zskKeySize",
      "displayName": "Zskkeysize",
      "type": "number",
      "required": false,
      "default": null,
      "description": "The size of the Zone Signing Key (ZSK) in bits to be used when using V(RSA) O(algorithm)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zskRolloverDays",
      "displayName": "Zskrolloverdays",
      "type": "number",
      "required": false,
      "default": null,
      "description": "ZSK rollover frequency in days",
      "choices": null,
