    {
      "name": "algorithm",
      "displayName": "Algorithm",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The algorithm to use for signing",
      "choices": [
        "RSA",
        "ECDSA",
        "EDDSA"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_port",
      "displayName": "Api Port",
      "type": "number",
      "required": false,
      "default": 5380,
      "description": "Port for the Technitium DNS API. Defaults to 5380",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_token",
      "displayName": "Api Token",
      "type": "string",
      "required": true,
      "default": null,
      "description": "API token for authentication",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_url",
      "displayName": "Api Url",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Base URL for the Technitium DNS API",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "curve",
      "displayName": "Curve",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The name of the curve to be used when using V(ECDSA) or V(EDDSA) O(algorithm) Use V(P256) or  V(P384) for V(ECDSA) O(algorithm) Use V(ED25519) or V(ED448) for V(EDDSA) O(algorithm)",
      "choices": [
        "P256",
        "P384",
        "ED25519",
        "ED448"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dnsKeyTtl",
      "displayName": "Dnskeyttl",
      "type": "number",
      "required": false,
      "default": null,
      "description": "TTL for DNSKEY records",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hashAlgorithm",
      "displayName": "Hashalgorithm",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The hash algorithm to be used when using V(RSA) O(algorithm)",
      "choices": [
        "MD5",
        "SHA1",
        "SHA256",
        "SHA512"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "iterations",
      "displayName": "Iterations",
      "type": "number",
      "required": false,
      "default": null,
      "description": "NSEC3 iterations",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "kskKeySize",
      "displayName": "Kskkeysize",
      "type": "number",
      "required": false,
      "default": null,
      "description": "The size of the Key Signing Key (KSK) in bits to be used when using V(RSA) O(algorithm)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "node",
      "displayName": "Node",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The node domain name for which this API call is intended When unspecified, the current node is used This parameter can be used only when Clustering is initialized",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "nxProof",
      "displayName": "Nxproof",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Proof of non-existence",
      "choices": [
        "NSEC",
        "NSEC3"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pemKskPrivateKey",
      "displayName": "Pemkskprivatekey",
      "type": "string",
      "required": false,
      "default": null,
      "description": "PEM private key for KSK When this parameter is specified, the private key specified is used instead of automatically generating it.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pemZskPrivateKey",
      "displayName": "Pemzskprivatekey",
      "type": "string",
      "required": false,
      "default": null,
      "description": "PEM private key for ZSK When this parameter is specified, the private key specified is used instead of automatically generating it.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "saltLength",
      "displayName": "Saltlength",
      "type": "number",
      "required": false,
      "default": null,
      "description": "NSEC3 salt length",
      "choices": null,
      "noLog": false,
