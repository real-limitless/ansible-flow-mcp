{
  "fqcn": "effectivelywild.technitium_dns.technitium_dns_sign_zone",
  "shortDescription": "Sign a DNS zone",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/effectivelywild/technitium_dns/technitium_dns_sign_zone_module.html",
