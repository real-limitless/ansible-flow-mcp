        "green",
        "yellow",
        "red"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "Response timeout in seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "to_be",
      "displayName": "To Be",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Used in conjunction with wait_for. Expected value of the wait_for variable",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "wait_for",
      "displayName": "Wait For",
      "type": "string",
      "required": false,
      "default": null,
