      "noLog": false,
      "suboptions": null
    },
    {
      "name": "environment",
      "displayName": "Environment",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the environment being deployed, for example V(production).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "revision",
      "displayName": "Revision",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Revision number/sha being deployed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "rollbar_user",
      "displayName": "Rollbar User",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Rollbar username of the user who deployed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
