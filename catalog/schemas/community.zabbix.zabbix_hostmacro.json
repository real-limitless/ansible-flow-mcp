{
  "fqcn": "community.zabbix.zabbix_hostmacro",
  "shortDescription": "Create/update/delete Zabbix host macros",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/zabbix/zabbix_hostmacro_module.html",
  "options": [
    {
      "name": "force",
      "displayName": "Force",
      "type": "boolean",
      "required": false,
      "default": "yes",
      "description": "Only updates an existing macro if set to C(yes).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "host_name",
      "displayName": "Host Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the host.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "http_login_password",
      "displayName": "Http Login Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Basic Auth password",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "http_login_user",
      "displayName": "Http Login User",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Basic Auth login",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "macro_description",
      "displayName": "Macro Description",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Text Description of the global macro.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "macro_name",
      "displayName": "Macro Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the host macro in zabbix native format C({$MACRO}) or simple format C(MACRO).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "macro_type",
      "displayName": "Macro Type",
      "type": "string",
      "required": false,
      "default": "text",
      "description": "Type of the host macro. text (default)",
      "choices": [
        "text",
        "secret",
        "vault"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "macro_value",
      "displayName": "Macro Value",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Value of the host macro. Required if I(state=present).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the macro. On C(present), it will create if macro does not exist or update the macro if the associated data is different. On C(absent) will remove a macro if it exists.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
