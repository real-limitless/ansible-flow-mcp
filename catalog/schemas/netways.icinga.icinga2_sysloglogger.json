{
  "fqcn": "netways.icinga.icinga2_sysloglogger",
  "shortDescription": "Creates information for SyslogLogger object.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/netways/icinga/icinga2_sysloglogger_module.html",
  "options": [
    {
      "name": "facility",
      "displayName": "Facility",
      "type": "string",
      "required": false,
      "default": "LOG_SYSLOG",
      "description": "Defines the facility to use for syslog entries. This can be a facility constant like FacilityDaemon.",
      "choices": [
        "LOG_AUTH",
        "LOG_AUTHPRIV",
        "LOG_CRON",
        "LOG_DAEMON",
        "LOG_FTP",
        "LOG_KERN",
        "LOG_LOCAL0",
        "LOG_LOCAL1",
        "LOG_LOCAL2",
        "LOG_LOCAL3",
        "LOG_LOCAL4",
        "LOG_LOCAL5",
        "LOG_LOCAL6",
        "LOG_LOCAL7",
        "LOG_LPR",
        "LOG_MAIL",
        "LOG_NEWS",
        "LOG_SYSLOG",
        "LOG_USER"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "file",
      "displayName": "File",
      "type": "string",
      "required": false,
      "default": "features-available/syslog.conf",
      "description": "Path to the file in which the object will be defined.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the SyslogLogger object.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "order",
      "displayName": "Order",
      "type": "number",
      "required": false,
      "default": 10,
      "description": "Value to determine internal precedence.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "severity",
      "displayName": "Severity",
      "type": "string",
      "required": false,
      "default": "warning",
      "description": "The minimum severity for this log. Can be debug, notice, information, warning or critical.",
      "choices": [
        "debug",
        "notice",
        "information",
        "warning",
        "critical"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The state of the SyslogLogger object.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
