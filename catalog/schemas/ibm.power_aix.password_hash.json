{
  "fqcn": "ibm.power_aix.password_hash",
  "shortDescription": "Encrypt password with AIX encryption methods",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ibm/power_aix/password_hash_module.html",
  "options": [
    {
      "name": "algorithm",
      "displayName": "Algorithm",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password encryption algorithm from /etc/security/pwdalg.cfg. If not specified, the filter tries to find the default encryption algorithm. If it fails, crypt is used.",
      "choices": [
        "smd5",
        "ssha1",
        "ssha256",
        "ssha512",
        "sblowfish",
        "crypt"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "A password to encrypt.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "salt",
      "displayName": "Salt",
      "type": "string",
      "required": false,
      "default": null,
      "description": "A string used to encrypt the password. If no salt is provided, a new random salt is generated.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
