{
  "fqcn": "ngine_io.cloudstack.metadata_facts",
  "shortDescription": "Gather facts on instances of Apache CloudStack based clouds.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ngine_io/cloudstack/metadata_facts_module.html",
  "options": [
    {
      "name": "filter",
      "displayName": "Filter",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Filter for a specific fact.",
      "choices": [
        "cloudstack_service_offering",
        "cloudstack_availability_zone",
        "cloudstack_public_hostname",
        "cloudstack_public_ipv4",
        "cloudstack_local_hostname",
        "cloudstack_local_ipv4",
        "cloudstack_instance_id",
        "cloudstack_user_data"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "meta_data_host",
      "displayName": "Meta Data Host",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Host or IP of the meta data API service. If not set, determination by parsing the dhcp lease file.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
