{
  "fqcn": "infinidat.infinibox.infini_metadata",
  "shortDescription": "Create, Delete or Modify metadata on Infinibox",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/infinidat/infinibox/infini_metadata_module.html",
  "options": [
    {
      "name": "key",
      "displayName": "Key",
      "type": "string",
