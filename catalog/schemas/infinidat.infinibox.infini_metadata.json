      "description": "Name of the metadata key",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "object_name",
      "displayName": "Object Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Name of the object. Not used if object_type is system",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "object_type",
      "displayName": "Object Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Type of object",
      "choices": [
        "cluster",
        "fs",
        "fs-snap",
        "host",
        "pool",
        "system",
        "vol",
        "vol-snap"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Infinibox User password.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Creates, modifies, removes or searches for metadata.",
      "choices": [
        "stat",
        "present",
        "absent",
        "search"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "stay_logged_in",
      "displayName": "Stay Logged In",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If True, persist API session to disk. Load the session on subsequent module calls. Persisted sessions are only usable for stay_logged_in_minutes.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "stay_logged_in_minutes",
      "displayName": "Stay Logged In Minutes",
      "type": "number",
      "required": false,
      "default": 5,
      "description": "Number of minutes for which a persisted session may be reused. After this time, the session data will be deleted. The time should be shorter than the IBOX session timeout time.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "system",
      "displayName": "System",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Infinibox Hostname or IPv4 Address.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "user",
      "displayName": "User",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Infinibox User username with sufficient priveledges ( see notes ).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "value",
      "displayName": "Value",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Value of the metadata key",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
