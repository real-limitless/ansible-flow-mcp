{
  "fqcn": "community.openwrt.service",
  "shortDescription": "Manage services on OpenWrt targets",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/openwrt/service_module.html",
  "options": [
    {
      "name": "enabled",
      "displayName": "Enabled",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Whether the service should start on boot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the service. Corresponds to the init script name in C(/etc/init.d/).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pattern",
      "displayName": "Pattern",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Pattern to search for in the process table to determine if the service is running. If specified, this pattern is used with C(pgrep) instead of the init script's running command.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Desired state of the service.",
      "choices": [
        "reloaded",
        "restarted",
        "started",
        "stopped"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
