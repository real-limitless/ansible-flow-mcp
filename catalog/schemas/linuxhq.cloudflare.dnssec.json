      "required": true,
      "default": null,
      "description": "Cloudflare API token with permissions to manage DNS settings.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dnssec_multi_signer",
      "displayName": "Dnssec Multi Signer",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Whether multi-signer DNSSEC is enabled.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dnssec_presigned",
      "displayName": "Dnssec Presigned",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Whether presigned DNSSEC is enabled.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dnssec_use_nsec3",
      "displayName": "Dnssec Use Nsec3",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Whether NSEC3 is enabled.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "status",
      "displayName": "Status",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Desired DNSSEC status. Only changed when explicitly provided.",
