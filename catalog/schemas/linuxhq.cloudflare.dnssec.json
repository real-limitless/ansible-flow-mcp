      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone_id",
      "displayName": "Zone Id",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Cloudflare zone identifier.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
