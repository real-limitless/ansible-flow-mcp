      "noLog": false,
      "suboptions": null
    },
    {
      "name": "fmgr_ha_file_quota",
      "displayName": "Fmgr Ha File Quota",
      "type": "string",
      "required": false,
      "default": 4096,
      "description": "Sets the File quota in MB (2048-20480).",
