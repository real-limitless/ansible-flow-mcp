{
  "fqcn": "community.general.nsupdate",
  "shortDescription": "Manage DNS records",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/nsupdate_module.html",
  "options": [
    {
      "name": "key_algorithm",
      "displayName": "Key Algorithm",
      "type": "string",
      "required": false,
      "default": "hmac-md5",
      "description": "Specify key algorithm used by O(key_secret). Use V(gss-tsig) for GSS-TSIG authentication (requires the gssapi library and Kerberos credentials). V(gss-tsig) was added in community.general 12.3.0.",
      "choices": [
        "HMAC-MD5.SIG-ALG.REG.INT",
        "hmac-md5",
        "hmac-sha1",
        "hmac-sha224",
        "hmac-sha256",
        "hmac-sha384",
        "hmac-sha512",
        "gss-tsig"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "key_name",
      "displayName": "Key Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Use TSIG key name to authenticate against DNS O(server). Not required when using O(key_algorithm=gss-tsig).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "key_secret",
      "displayName": "Key Secret",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Use TSIG key secret, associated with O(key_name), to authenticate against O(server). Not required when using O(key_algorithm=gss-tsig).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": 53,
      "description": "Use this TCP port when connecting to O(server).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "protocol",
      "displayName": "Protocol",
      "type": "string",
      "required": false,
      "default": "tcp",
      "description": "Sets the transport protocol (TCP or UDP). TCP is the recommended and a more robust option.",
      "choices": [
        "tcp",
        "udp"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "record",
      "displayName": "Record",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Sets the DNS record to modify. When zone is omitted this has to be absolute (ending with a dot).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server",
      "displayName": "Server",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Apply DNS modification on this server, specified by IPv4/IPv6 address or FQDN. FQDNs are supported since community.general 12.3.0.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Manage DNS record.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 10,
      "description": "Timeout in seconds for each DNS query sent to O(server).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ttl",
      "displayName": "Ttl",
      "type": "number",
      "required": false,
      "default": 3600,
      "description": "Sets the record TTL.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "type",
      "displayName": "Type",
      "type": "string",
      "required": false,
      "default": "A",
      "description": "Sets the record type.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "value",
      "displayName": "Value",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Sets the record value.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone",
      "displayName": "Zone",
      "type": "string",
      "required": false,
      "default": null,
      "description": "DNS record is modified on this O(zone). When omitted, DNS is queried to attempt finding the correct zone.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
