{
  "fqcn": "community.elastic.elastic_snapshot",
  "shortDescription": "Manage Elasticsearch Snapshots.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/elastic/elastic_snapshot_module.html",
  "options": [
    {
      "name": "api_key_encoded",
      "displayName": "Api Key Encoded",
      "type": "string",
      "required": false,
      "default": null,
      "description": "API key credentials which is the Base64-encoding of the UTF-8\\ representation of the id and api_key joined by a colon (:). Supported from Elastic 8+. See [Create API Key](https://www.elastic.co/guide/en/elasticsearch/reference/current/security-api-create-api-key.html) documentation for specifics.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_method",
      "displayName": "Auth Method",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Authentication Method.",
      "choices": [
        "",
        "http_auth",
        "api_key"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_scheme",
      "displayName": "Auth Scheme",
      "type": "string",
      "required": false,
      "default": "http",
      "description": "Authentication scheme.",
      "choices": [
        "http",
        "https"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "cafile",
      "displayName": "Cafile",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Path to ca file",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "connection_options",
      "displayName": "Connection Options",
      "type": "dict",
      "required": false,
      "default": {},
      "description": "Additional connection options for Elasticsearch",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ignore_unavailable",
      "displayName": "Ignore Unavailable",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If false, the request returns an error for any data stream or index that is missing or closed. If true, the request ignores data streams and indices in indices that are missing or closed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "indices",
      "displayName": "Indices",
      "type": "list",
      "required": false,
      "default": null,
      "description": "A list of indexes to include in the the snapshot. By default, a snapshot includes all data streams and indices in the cluster. If this argument is provided, the snapshot only includes the specified data streams and clusters.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_hosts",
      "displayName": "Login Hosts",
      "type": "list",
      "required": false,
      "default": "localhost",
      "description": "The Elastic hosts to connect to. Can accept hostnames or URLs. If a hostname then values\\ login_port and login_scheme will be used to construct a URL.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_password",
      "displayName": "Login Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The password used to authenticate with. Required when I(login_user) is specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_port",
      "displayName": "Login Port",
      "type": "number",
      "required": false,
      "default": 9200,
      "description": "The Elastic server port to login to.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_user",
      "displayName": "Login User",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The Elastic user to login with. Required when I(login_password) is specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "metadata",
      "displayName": "Metadata",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Attaches arbitrary metadata to the snapshot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the snapshot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "partial",
      "displayName": "Partial",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If false, the entire snapshot will fail if one or more indices included in the snapshot do not have all primary shards available.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "repository",
      "displayName": "Repository",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Snapshot repository name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The desired state of the snapshot.",
      "choices": [
        "present",
        "absent",
        "restore"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "Response timeout in seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
