{
  "fqcn": "geant.gap_ansible.nokia_netconf_config",
  "shortDescription": "NETCONF configuration for Nokia SR OS using server-side <md-compare>",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/geant/gap_ansible/nokia_netconf_config_module.html",
  "options": [
    {
      "name": "commit",
      "displayName": "Commit",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Commit after editing candidate (if supported). Commits even if md-compare shows no diff (no-op on box).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "commit_comment",
      "displayName": "Commit Comment",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Optional commit comment.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "config_mode",
      "displayName": "Config Mode",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Nokia configuration mode (only 'private' supported here).",
      "choices": [
        "private"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "confirm",
      "displayName": "Confirm",
      "type": "number",
      "required": false,
      "default": 0,
      "description": "Confirmed-commit timeout (seconds). 0 confirms immediately. Requires :candidate & :confirmed-commit.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "confirm_commit",
      "displayName": "Confirm Commit",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Execute a commit operation (can confirm a previous commit).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "content",
      "displayName": "Content",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Configuration payload; XML string (root <config>), text, or dict-as-JSON (converted to XML).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "default_operation",
      "displayName": "Default Operation",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Default operation for <edit-config>.",
      "choices": [
        "merge",
        "replace",
        "none"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "delete",
      "displayName": "Delete",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Delete configuration from target datastore.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "error_option",
      "displayName": "Error Option",
      "type": "string",
      "required": false,
      "default": "stop-on-error",
      "description": "NETCONF server action on error.",
      "choices": [
        "stop-on-error",
        "continue-on-error",
        "rollback-on-error"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "format",
      "displayName": "Format",
      "type": "string",
      "required": false,
      "default": null,
      "description": "{'Format of C(content)': 'xml|text|json. Defaults to xml if not detected.'}",
      "choices": [
        "xml",
        "text",
        "json"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "lock",
      "displayName": "Lock",
      "type": "string",
      "required": false,
      "default": "always",
      "description": "Lock behavior for target datastore.",
      "choices": [
        "never",
        "always",
        "if-supported"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "save",
      "displayName": "Save",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If changed (per md-compare) and commit succeeds, copy to startup (requires :startup).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "target",
      "displayName": "Target",
      "type": "string",
      "required": false,
      "default": "auto",
      "description": "Datastore to edit. 'auto' prefers candidate if supported.",
      "choices": [
        "auto",
        "candidate",
        "running"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate",
      "displayName": "Validate",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Validate the target datastore (requires :validate).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
