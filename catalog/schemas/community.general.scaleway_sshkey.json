{
  "fqcn": "community.general.scaleway_sshkey",
  "shortDescription": "Scaleway SSH keys management module",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/scaleway_sshkey_module.html",
  "options": [
    {
      "name": "api_timeout",
      "displayName": "Api Timeout",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "HTTP timeout to Scaleway API in seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_token",
      "displayName": "Api Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Scaleway OAuth token. This is required if O(profile) is not specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_url",
      "displayName": "Api Url",
      "type": "string",
      "required": false,
      "default": "https://account.scaleway.com",
      "description": "Scaleway API URL.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "profile",
      "displayName": "Profile",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The config profile in config file to load the Scaleway OAuth token from, use instead of O(api_token). It is also possible to set E(SCW_PROFILE) to use a SCW CLI config profile.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "query_parameters",
      "displayName": "Query Parameters",
      "type": "dict",
      "required": false,
      "default": {},
      "description": "List of parameters passed to the query string.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ssh_pub_key",
      "displayName": "Ssh Pub Key",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The public SSH key as a string to add.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Indicate desired state of the SSH key.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Validate SSL certs of the Scaleway API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
