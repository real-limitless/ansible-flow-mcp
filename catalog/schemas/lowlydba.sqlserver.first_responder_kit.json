{
  "fqcn": "lowlydba.sqlserver.first_responder_kit",
  "shortDescription": "Install/update the First Responder Kit scripts",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/lowlydba/sqlserver/first_responder_kit_module.html",
  "options": [
    {
      "name": "branch",
      "displayName": "Branch",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies an alternate branch of the First Responder Kit to install.",
      "choices": [
        "main",
        "dev"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "database",
      "displayName": "Database",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the target database.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "force",
      "displayName": "Force",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If this switch is enabled, the FRK will be downloaded from the internet even if previously cached.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "local_file",
      "displayName": "Local File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the path to a local file to install FRK from. This should be the zip file as distributed by the maintainers. If this option is not specified, the latest version will be downloaded and installed Github.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "only_script",
      "displayName": "Only Script",
      "type": "string",
      "required": false,
      "default": "Install-All-Scripts.sql",
      "description": "Specifies the name(s) of the script(s) to run for installation. Wildcards are permitted. This way only part of the First Responder Kit can be installed.",
      "choices": [
        "Install-All-Scripts.sql",
        "Install-Core-Blitz-No-Query-Store.sql",
        "Install-Core-Blitz-With-Query-Store.sql",
        "sp_Blitz.sql",
        "sp_BlitzFirst.sql",
        "sp_BlitzIndex.sql",
        "sp_BlitzCache.sql",
        "sp_BlitzWho.sql",
        "sp_BlitzQueryStore.sql",
        "sp_BlitzAnalysis.sql",
        "sp_BlitzBackups.sql",
        "sp_BlitzInMemoryOLTP.sql",
        "sp_BlitzLock.sql",
        "sp_AllNightLog.sql",
        "sp_AllNightLog_Setup.sql",
        "sp_DatabaseRestore.sql",
        "sp_ineachdb.sql",
        "SqlServerVersions.sql",
        "Uninstall.sql"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "sql_instance",
      "displayName": "Sql Instance",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The SQL Server instance to modify.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "sql_password",
      "displayName": "Sql Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password for SQL Authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "sql_username",
      "displayName": "Sql Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Username for SQL Authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
