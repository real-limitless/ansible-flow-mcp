{
  "fqcn": "blumleon.vrp.vrp_interface",
  "shortDescription": "Configures Huawei VRP interfaces (L1 & L2) idempotently",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/blumleon/vrp/vrp_interface_module.html",
  "options": [
    {
      "name": "admin_state",
      "displayName": "Admin State",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Administrative interface state",
      "choices": [
        "up",
        "down"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Interface description (empty = remove)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mtu",
      "displayName": "Mtu",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Maximum packet size in bytes, e.g. C(1500)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Interface name, e.g. C(MultiGE1/0/20)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "native_vlan",
      "displayName": "Native Vlan",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Native VLAN for trunk ports (sets PVID)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port_mode",
      "displayName": "Port Mode",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Layer-2 port mode",
      "choices": [
        "access",
        "trunk",
        "hybrid"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "save_when",
      "displayName": "Save When",
      "type": "string",
      "required": false,
      "default": "changed",
      "description": "When to save the configuration",
      "choices": [
        "never",
        "changed",
        "always"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "speed",
      "displayName": "Speed",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Fixed speed, e.g. C(1000), depending on the model",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Sets the interface to C(present) (configure) or C(absent) (reset)",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "stp_edged",
      "displayName": "Stp Edged",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enables STP edge port mode (fast transition to forwarding) Only valid in access mode",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "trunk_vlans",
      "displayName": "Trunk Vlans",
      "type": "string",
      "required": false,
      "default": null,
      "description": "VLAN list for trunk or hybrid ports, e.g. C(10,20-30) The keyword C(all) is supported and expands to C(2 to 4094)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "vlan",
      "displayName": "Vlan",
      "type": "number",
      "required": false,
      "default": null,
      "description": "VLAN ID for access ports",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
