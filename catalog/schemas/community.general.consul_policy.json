{
  "fqcn": "community.general.consul_policy",
  "shortDescription": "Manipulate Consul policies",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/consul_policy_module.html",
  "options": [
    {
      "name": "ca_path",
      "displayName": "Ca Path",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The CA bundle to use for https connections.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Description of the policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": false,
      "default": "localhost",
      "description": "Host of the Consul agent.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name that should be associated with the policy, this is opaque to Consul.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": 8500,
      "description": "The port on which the consul agent is running.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "rules",
      "displayName": "Rules",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Rule document that should be associated with the current policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "scheme",
      "displayName": "Scheme",
      "type": "string",
      "required": false,
      "default": "http",
      "description": "The protocol scheme on which the Consul agent is running. Defaults to V(http) and can be set to V(https) for secure connections.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the policy should be present or absent.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "token",
      "displayName": "Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The token to use for authorization.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "valid_datacenters",
      "displayName": "Valid Datacenters",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Valid datacenters for the policy. All if list is empty.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether to verify the TLS certificate of the Consul agent.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
