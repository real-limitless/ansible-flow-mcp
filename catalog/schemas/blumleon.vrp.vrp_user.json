{
  "fqcn": "blumleon.vrp.vrp_user",
  "shortDescription": "Manage local AAA users and SSH key access on Huawei VRP devices",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/blumleon/vrp/vrp_user_module.html",
  "options": [
    {
      "name": "level",
      "displayName": "Level",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Privilege level of the user (e.g. 1-3).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the user account.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "User password (stored using irreversible-cipher). Ignored if C(ssh_key) is set.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "save_when",
      "displayName": "Save When",
      "type": "string",
      "required": false,
      "default": "changed",
      "description": "When to save the device configuration.",
      "choices": [
        "never",
        "changed",
        "always"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "service_type",
      "displayName": "Service Type",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Protocols the user is allowed to use.",
      "choices": [
        "ssh",
        "telnet"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ssh_key",
      "displayName": "Ssh Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Public key in OpenSSH format. If specified, the user will be created without a password and authenticated via RSA.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the user should be present or removed.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
