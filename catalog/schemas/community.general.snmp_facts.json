{
  "fqcn": "community.general.snmp_facts",
  "shortDescription": "Retrieve facts for a device using SNMP",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/snmp_facts_module.html",
  "options": [
    {
      "name": "authkey",
      "displayName": "Authkey",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Authentication key. Required O(version=v3).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "community",
      "displayName": "Community",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The SNMP community string, required if O(version) is V(v2) or V(v2c).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Set to target SNMP server (normally C({{ inventory_hostname }})).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "integrity",
      "displayName": "Integrity",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Hashing algorithm. Required if O(version=v3).",
      "choices": [
        "md5",
        "sha"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "level",
      "displayName": "Level",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Authentication level. Required if O(version=v3).",
      "choices": [
        "authNoPriv",
        "authPriv"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "privacy",
      "displayName": "Privacy",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Encryption algorithm. Required if O(level=authPriv).",
      "choices": [
        "aes",
        "des"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "privkey",
      "displayName": "Privkey",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Encryption key. Required if O(level=authPriv).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "retries",
      "displayName": "Retries",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Maximum number of request retries, 0 retries means just a single request.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": null,
      "description": "Response timeout in seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Username for SNMPv3. Required if O(version=v3).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "version",
      "displayName": "Version",
      "type": "string",
      "required": true,
      "default": null,
      "description": "SNMP Version to use, V(v2), V(v2c) or V(v3).",
      "choices": [
        "v2",
        "v2c",
        "v3"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
