{
  "fqcn": "containers.podman.podman_system_connection",
  "shortDescription": "Manage podman system connections",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/containers/podman/podman_system_connection_module.html",
  "options": [
    {
      "name": "default",
      "displayName": "Default",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Make this connection the default for this user",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "destination",
      "displayName": "Destination",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Destination for the connection. Required when I(state=present). Can be in the format C([user@]hostname[:port]), C(ssh://[user@]hostname[:port]), C(unix://path), C(tcp://hostname:port)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "executable",
      "displayName": "Executable",
      "type": "string",
      "required": false,
      "default": "podman",
      "description": "Path to C(podman) executable if it is not in the C($PATH) on the machine running C(podman)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "identity",
      "displayName": "Identity",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Path to SSH identity file",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the connection",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "new_name",
      "displayName": "New Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "New name for the connection when renaming (used with I(state=present))",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": null,
      "description": "SSH port (default is 22)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "socket_path",
      "displayName": "Socket Path",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Path to the Podman service unix domain socket on the ssh destination host",
      "choices": null,
      "noLog": false,
      "suboptions": null
