{
  "fqcn": "ctera.ctera.ctera_portal_syslog",
  "shortDescription": "CTERA Portal server management",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ctera/ctera/ctera_portal_syslog_module.html",
  "options": [
    {
      "name": "min_severity",
      "displayName": "Min Severity",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Minimum severity of log messages to forward",
      "choices": [
        "emergency",
        "alert",
        "critical",
        "error",
        "warning",
        "notice",
        "info",
        "debug"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": null,
      "description": "The new server name",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server",
      "displayName": "Server",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The syslog server ip addr, hostname or FQDN",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "enabled",
      "description": "Whether forwarding log messages over syslog should be enabled or not.",
      "choices": [
        "enabled",
        "disabled"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "tenant",
      "displayName": "Tenant",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Name of the tenant. For Global Admin operations set to \"$admin\" Use default if not provided. Do not set for initialization operations",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
