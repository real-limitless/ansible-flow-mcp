{
  "fqcn": "sap.sap_operations.pcs_auth",
  "shortDescription": "Module for managing cluster node authorization with 'pcs auth' commands",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/sap/sap_operations/pcs_auth_module.html",
  "options": [
    {
      "name": "node_name",
      "displayName": "Node Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "hostname of node for authentication",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "password for cluster authentication",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pcsd_conf_filepath",
      "displayName": "Pcsd Conf Filepath",
      "type": "string",
      "required": false,
      "default": "",
      "description": "path to pcsd configuration file only required if pcsd configuration file is in unusual location or for testing",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "'present' authenticates the node while 'absent' will remove the node authentication node from which this is run is (de)authenticated against the node specified in 'node_name'",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": false,
      "default": "hacluster",
      "description": "username of user for cluster authentication",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
