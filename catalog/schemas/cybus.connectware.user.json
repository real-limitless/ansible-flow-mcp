      "description": "Admin password (used with basic auth)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "admin_user",
      "displayName": "Admin User",
      "type": "string",
      "required": false,
      "default": "admin",
      "description": "Admin username (used with basic auth)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_timeout",
      "displayName": "Api Timeout",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "Timeout for API calls",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "bearer_token",
      "displayName": "Bearer Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Bearer token for authentication (preferred method)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
