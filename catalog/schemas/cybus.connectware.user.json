      "displayName": "Check Password",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Flag to disable user password checking",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enforce_mfa_enrollment",
      "displayName": "Enforce Mfa Enrollment",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Whether the user is forced to enroll MFA at their next login. The actual MFA enrollment (e.g. scanning the TOTP QR code) is always completed by the user themselves. Requires MFA to be enabled on the Connectware deployment for the enforcement to take effect at login. If unset, the flag is left untouched, e.g. when it is managed via the Admin UI.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "grant_types",
      "displayName": "Grant Types",
      "type": "list",
      "required": false,
      "default": [
        "password",
        "token"
      ],
      "description": "List of supported grant types",
      "choices": [
        "password",
        "token",
        "certificate"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "identity_provider",
      "displayName": "Identity Provider",
      "type": "string",
      "required": false,
      "default": "local",
      "description": "Identity source for the user.",
      "choices": [
        "local",
        "ldap",
        "msentraid"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "manage_permissions",
      "displayName": "Manage Permissions",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether to reconcile the user's direct permissions. Set this to C(false) for LDAP or Microsoft Entra ID users when direct permissions should not be managed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mqtt_publish_prefix",
