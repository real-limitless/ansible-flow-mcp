    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State in which to leave the rule",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
