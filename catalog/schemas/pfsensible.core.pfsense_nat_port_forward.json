      "required": false,
      "default": false,
      "description": "Is the rule disabled",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "interface",
      "displayName": "Interface",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The interface for the rule",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ipprotocol",
