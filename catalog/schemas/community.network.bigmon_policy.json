{
  "fqcn": "community.network.bigmon_policy",
  "shortDescription": "Create and remove a bigmon out-of-band policy.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/network/bigmon_policy_module.html",
  "options": [
    {
      "name": "access_token",
      "displayName": "Access Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Bigmon access token. If this isn't set, the environment variable C(BIGSWITCH_ACCESS_TOKEN) is used.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "action",
      "displayName": "Action",
      "type": "string",
      "required": false,
      "default": "forward",
      "description": "Forward matching packets to delivery interfaces, Drop is for measure rate of matching packets, but do not forward to delivery interfaces, capture packets and write to a PCAP file, or enable NetFlow generation.",
      "choices": [
        "forward",
        "drop",
        "flow-gen"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "controller",
      "displayName": "Controller",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The controller address.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "delivery_packet_count",
      "displayName": "Delivery Packet Count",
      "type": "string",
      "required": false,
      "default": 0,
      "description": "Run policy until delivery_packet_count packets are delivered.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "duration",
      "displayName": "Duration",
      "type": "string",
      "required": false,
      "default": 0,
      "description": "Run policy for duration duration or until delivery_packet_count packets are delivered, whichever comes first.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "policy_description",
      "displayName": "Policy Description",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Description of policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "priority",
      "displayName": "Priority",
      "type": "string",
      "required": false,
      "default": 100,
      "description": "A priority associated with this policy. The higher priority policy takes precedence over a lower priority.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "start_time",
      "displayName": "Start Time",
      "type": "string",
      "required": false,
      "default": "ansible_date_time.iso8601",
      "description": "Date the policy becomes active",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the policy should be present or absent.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "If C(false), SSL certificates will not be validated. This should only be used on personally controlled devices using self-signed certificates.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
