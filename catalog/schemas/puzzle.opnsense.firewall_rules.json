    {
      "name": "action",
      "displayName": "Action",
      "type": "string",
      "required": false,
      "default": "pass",
      "description": "Choose what to do with packets that match the criteria specified below.",
      "choices": [
        "pass",
        "block",
        "reject"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "category",
      "displayName": "Category",
      "type": "string",
      "required": false,
