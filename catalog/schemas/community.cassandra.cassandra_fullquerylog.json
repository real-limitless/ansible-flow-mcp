{
  "fqcn": "community.cassandra.cassandra_fullquerylog",
  "shortDescription": "Manages the full query log feature.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/cassandra/cassandra_fullquerylog_module.html",
  "options": [
    {
      "name": "archive_command",
      "displayName": "Archive Command",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Command that will handle archiving rolled full query log files. Format is \"/path/to/script.sh %path\" where %path will be replaced with the file to archive.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "blocking",
      "displayName": "Blocking",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "If the queue is full whether to block producers or drop samples.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "cassandra_version",
      "displayName": "Cassandra Version",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Version of Cassandra being connected to by nodetool. If a value if not provided we use `nodetool version`to auto-discover it.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Enable extra debug output.",
