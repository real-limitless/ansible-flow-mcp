{
  "fqcn": "community.general.bower",
  "shortDescription": "Manage bower packages with C(bower)",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/bower_module.html",
  "options": [
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The name of a bower package to install.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "offline",
      "displayName": "Offline",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Install packages from local cache, if the packages were installed before.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "path",
      "displayName": "Path",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The base path where to install the bower packages.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "production",
      "displayName": "Production",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Install with C(--production) flag.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "relative_execpath",
      "displayName": "Relative Execpath",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Relative path to bower executable from install path.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The state of the bower package.",
      "choices": [
        "present",
        "absent",
        "latest"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "version",
      "displayName": "Version",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The version to be installed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
