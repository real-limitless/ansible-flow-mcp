      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "nfsv4",
      "displayName": "Nfsv4",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "Specifies the minor versions of NFSv4 protocol.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "onefs_host",
      "displayName": "Onefs Host",
