  "options": [
    {
      "name": "api_password",
      "displayName": "Api Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "the password of the PowerScale cluster.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_user",
      "displayName": "Api User",
      "type": "string",
      "required": true,
      "default": null,
      "description": "username of the PowerScale cluster.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
