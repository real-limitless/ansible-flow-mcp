      "displayName": "Service",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Specifies if the NFS service needs to be enabled or not.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "verify_ssl",
      "displayName": "Verify Ssl",
      "type": "boolean",
      "required": true,
      "default": null,
      "description": "boolean variable to specify whether to validate SSL certificate or not. C(true) - indicates that the SSL certificate should be verified. C(false) - indicates that the SSL certificate should not be verified.",
      "choices": [
        true,
        false
      ],
      "noLog": false,
      "suboptions": null
    }
