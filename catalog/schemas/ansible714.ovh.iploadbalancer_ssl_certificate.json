{
  "fqcn": "ansible714.ovh.iploadbalancer_ssl_certificate",
  "shortDescription": "Manage ssl/tls certificates for IpLoadBalancer",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ansible714/ovh/iploadbalancer_ssl_certificate_module.html",
  "options": [
    {
      "name": "certificate",
      "displayName": "Certificate",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Certificate (should be unique)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "chain",
      "displayName": "Chain",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Certificate chain",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "fqdn",
      "displayName": "Fqdn",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Certificate Full Qualified Domain Name for this certificate.\nFQDN will be unique on a given load-balancer, certificate with same FQDN but different\nserial number or fingerprint will be replaced.\nThis enable certificate renewal without duplication of FQDN on load-balancer\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "free_certificate",
      "displayName": "Free Certificate",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "This module can manage both Custome & Free certificates for IpLoadBalancer.\nFree Certificates are Let's Encrypt certificates managed and renewed by Ovh\n\n*A certificate cannot be both free and custom...*\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "key",
      "displayName": "Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Certificate key",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "lb_name",
      "displayName": "Lb Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the IpLoadBalancer",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Human readable name for your ssl certificate",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ovh_api_application_key",
      "displayName": "Ovh Api Application Key",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Application Key obtained from OVH",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ovh_api_application_secret",
      "displayName": "Ovh Api Application Secret",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Application Secret obtained from OVH",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ovh_api_consumer_key",
      "displayName": "Ovh Api Consumer Key",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Consumer key, created via OVH-Api and configured with the rights\nto use all the needed endoints (the one that you will be using)\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ovh_api_endpoint",
      "displayName": "Ovh Api Endpoint",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Which OVH Api endpoint to use",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pem_file",
      "displayName": "Pem File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "PEM file containing Certificate, must contain certificate and key.\nCan also contain full-chain (as in let's encrypt)\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Indicate the desired state of the Frontend",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
