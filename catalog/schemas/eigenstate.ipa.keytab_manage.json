{
  "fqcn": "eigenstate.ipa.keytab_manage",
  "shortDescription": "Retrieve or rotate Kerberos keytabs with explicit module semantics",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/eigenstate/ipa/keytab_manage_module.html",
  "options": [
    {
      "name": "confirm_rotation",
      "displayName": "Confirm Rotation",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Required confirmation gate for C(state=rotated).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "destination",
      "displayName": "Destination",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Optional controller-local path where the keytab should be written.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enctypes",
      "displayName": "Enctypes",
      "type": "list",
      "required": false,
      "default": [],
      "description": "Kerberos encryption types to request.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "group",
      "displayName": "Group",
      "type": "string",
      "required": false,
      "default": null,
      "description": "File group name or numeric GID for C(destination).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ipaadmin_password",
      "displayName": "Ipaadmin Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password for the principal. Used to obtain a Kerberos ticket via C(kinit). Not required if C(kerberos_keytab) is set or a valid ticket already exists.",
      "choices": null,
      "noLog": true,
      "suboptions": null
    },
    {
      "name": "ipaadmin_principal",
      "displayName": "Ipaadmin Principal",
      "type": "string",
      "required": false,
      "default": "admin",
      "description": "Kerberos principal to authenticate as.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "kerberos_keytab",
      "displayName": "Kerberos Keytab",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Path to a Kerberos keytab file for non-interactive authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mode",
      "displayName": "Mode",
      "type": "string",
      "required": false,
      "default": "0600",
      "description": "File mode to apply when C(destination) is set.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "owner",
      "displayName": "Owner",
      "type": "string",
      "required": false,
      "default": null,
      "description": "File owner name or numeric UID for C(destination).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "principal",
      "displayName": "Principal",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Kerberos service or host principal whose keytab is managed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "return_content",
      "displayName": "Return Content",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Return the base64-encoded keytab content.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server",
      "displayName": "Server",
      "type": "string",
      "required": true,
      "default": null,
      "description": "FQDN of the IPA server.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "retrieved",
      "description": "C(retrieved) retrieves existing keys only. C(rotated) generates new keys and invalidates all existing keytabs for the principal.",
      "choices": [
        "retrieved",
        "rotated"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "verify",
      "displayName": "Verify",
      "type": "string",
      "required": false,
      "default": null,
      "description": "IPA CA certificate path for C(ipa-getkeytab --cacert), or C(false) to rely on the local trust store.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
