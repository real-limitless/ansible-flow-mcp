{
  "fqcn": "sap.sap_operations.system",
  "shortDescription": "Manage SAP system",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/sap/sap_operations/system_module.html",
  "options": [
    {
      "name": "ca_file",
      "displayName": "Ca File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "I(ca_file) use CA certificate to secure the communication. By default system CA store is used.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hostname",
      "displayName": "Hostname",
      "type": "string",
      "required": false,
      "default": null,
      "description": "I(hostname) of the SAP system",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "instance_number",
      "displayName": "Instance Number",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The instance number of the managed service. Must be between \"0\" and \"99\".",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": "ALL",
      "description": "I(name) name of the feature to be managed.",
      "choices": [
        "ALL",
        "SCS",
        "DIALOG",
        "ABAP",
        "J2EE",
        "TREX",
        "ENQREP",
        "HDB",
        "ALLNOHDB",
        "LEVEL"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "I(password) of the SAP system",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "secure",
      "displayName": "Secure",
      "type": "string",
      "required": false,
      "default": "strict",
      "description": "I(secure) specify if secure communication should be enforced. By default system CA store is used. User can pass custom CA by I(ca_file) parameter.",
      "choices": [
        "strict",
        "insecure",
        "none"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "started",
      "description": "State of the managed system.",
      "choices": [
        "started",
        "stopped"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "I(username) of the SAP system",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "wait",
      "displayName": "Wait",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Wait for the operation to complete before returning. If set to C(true), module will wait for service to start/ or stop. If set to C(false), module will schedule the right operation and return immediately.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "wait_timeout",
      "displayName": "Wait Timeout",
      "type": "number",
      "required": false,
      "default": 600,
      "description": "Wait timeout for the operation to complete before returning.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
