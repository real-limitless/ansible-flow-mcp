        "sysdba",
        "sysdg",
        "sysoper",
        "sysasm"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The Oracle user password for the user",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
