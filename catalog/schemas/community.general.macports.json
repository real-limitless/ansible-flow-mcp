{
  "fqcn": "community.general.macports",
  "shortDescription": "Package manager for MacPorts",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/macports_module.html",
  "options": [
    {
      "name": "name",
      "displayName": "Name",
      "type": "list",
      "required": false,
      "default": null,
      "description": "A list of port names.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "selfupdate",
      "displayName": "Selfupdate",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Update Macports and the ports tree, either prior to installing ports or as a separate step. Equivalent to running C(port selfupdate).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Indicates the desired state of the port.",
      "choices": [
        "present",
        "absent",
        "active",
        "inactive",
        "installed",
        "removed"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "upgrade",
      "displayName": "Upgrade",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Upgrade all outdated ports, either prior to installing ports or as a separate step. Equivalent to running C(port upgrade outdated).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "variant",
      "displayName": "Variant",
      "type": "string",
      "required": false,
      "default": null,
      "description": "A port variant specification. O(variant) is only supported with O(state=installed) and O(state=present).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
