{
  "fqcn": "community.digitalocean.digital_ocean_certificate",
  "shortDescription": "Manage certificates in DigitalOcean",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/digitalocean/digital_ocean_certificate_module.html",
  "options": [
    {
      "name": "baseurl",
      "displayName": "Baseurl",
      "type": "string",
      "required": false,
      "default": "https://api.digitalocean.com/v2",
      "description": "DigitalOcean API base url.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "certificate_chain",
      "displayName": "Certificate Chain",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The full PEM-formatted trust chain between the certificate authority's certificate and your domain's SSL certificate.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "leaf_certificate",
      "displayName": "Leaf Certificate",
      "type": "string",
      "required": false,
      "default": null,
      "description": "A PEM-formatted public SSL Certificate.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the certificate.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "oauth_token",
      "displayName": "Oauth Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "DigitalOcean OAuth token. There are several other environment variables which can be used to provide this value. i.e., - C(DO_API_TOKEN), C(DO_API_KEY), C(DO_OAUTH_TOKEN) and C(OAUTH_TOKEN).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "private_key",
      "displayName": "Private Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "A PEM-formatted private key content of SSL Certificate.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the certificate should be present or absent.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "The timeout in seconds used for polling DigitalOcean's API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "If set to C(no), the SSL certificates will not be validated. This should only set to C(no) used on personally controlled sites using self-signed certificates.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
