{
  "fqcn": "arubanetworks.aoscx.aoscx_facts",
  "shortDescription": "Collects facts from remote AOS-CX device",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/arubanetworks/aoscx/aoscx_facts_module.html",
  "options": [
    {
      "name": "gather_network_resources",
      "displayName": "Gather Network Resources",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Retrieve vlan, interface, lldp_neighbors or vrf information. This can be a single category or it can be a list. Leaving this field blank returns all interfaces, vlans, and vrfs.\n",
      "choices": [
        "interfaces",
        "vlans",
        "vrfs",
        "lldp_neighbors"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "gather_subset",
      "displayName": "Gather Subset",
      "type": "list",
      "required": false,
      "default": [
        "domain_name",
        "fans",
        "host_name",
        "management_interface",
        "physical_interfaces",
        "platform_name",
        "power_supplies",
        "product_info",
        "resource_utilization",
        "software_images",
        "software_info",
        "software_version"
      ],
      "description": "Retrieve a subset of all device information. This can be a single category or it can be a list. As warning, leaving this field blank returns all facts, which may be an intensive process.\n",
      "choices": [
        "config",
        "domain_name",
        "fans",
        "host_name",
        "management_interface",
        "physical_interfaces",
        "platform_name",
        "power_supplies",
        "product_info",
        "resource_utilization",
        "software_images",
        "software_info",
        "software_version"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
