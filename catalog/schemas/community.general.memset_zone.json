{
  "fqcn": "community.general.memset_zone",
  "shortDescription": "Creates and deletes Memset DNS zones",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/memset_zone_module.html",
  "options": [
    {
      "name": "api_key",
      "displayName": "Api Key",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The API key obtained from the Memset control panel.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "force",
      "displayName": "Force",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Forces deletion of a zone and all zone domains/zone records it contains.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The zone nickname; usually the same as the main domain. Ensure this value has at most 250 characters.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Indicates desired state of resource.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ttl",
      "displayName": "Ttl",
      "type": "number",
      "required": false,
      "default": 0,
      "description": "The default TTL for all records created in the zone. This must be a valid int from U(https://www.memset.com/apidocs/methods_dns.html#dns.zone_create).",
      "choices": [
        0,
        300,
        600,
        900,
        1800,
        3600,
        7200,
        10800,
        21600,
        43200,
        86400
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
