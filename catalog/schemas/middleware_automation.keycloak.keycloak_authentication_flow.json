      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "copy_from",
      "displayName": "Copy From",
      "type": "string",
      "required": false,
      "default": null,
      "description": "If set, the new flow is created as a copy of the flow with this alias. Cannot be used together with O(executions).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Description of the authentication flow.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "executions",
      "displayName": "Executions",
      "type": "list",
      "required": false,
      "default": [],
      "description": "A list of executions (authenticator steps) to add to the flow. Each execution is a dict with keys C(provider_id) (or C(providerId)) and C(requirement). Executions are only added when the flow is first created.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "http_agent",
      "displayName": "Http Agent",
      "type": "string",
      "required": false,
      "default": "Ansible",
      "description": "Configures the HTTP User-Agent header.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "provider_id",
      "displayName": "Provider Id",
      "type": "string",
      "required": false,
      "default": "basic-flow",
      "description": "The provider ID for the flow.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "realm",
      "displayName": "Realm",
      "type": "string",
      "required": false,
      "default": "master",
      "description": "The Keycloak realm under which this authentication flow resides.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "refresh_token",
      "displayName": "Refresh Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Authentication refresh token for Keycloak API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the authentication flow. On V(present), the flow will be created if it does not yet exist. On V(absent), the flow will be removed if it exists.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "token",
      "displayName": "Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Authentication token for Keycloak API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Verify TLS certificates (do not disable this in production).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
