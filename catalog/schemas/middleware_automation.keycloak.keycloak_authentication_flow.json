{
  "fqcn": "middleware_automation.keycloak.keycloak_authentication_flow",
  "shortDescription": "Allows administration of Keycloak authentication flows via Keycloak API",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/middleware_automation/keycloak/keycloak_authentication_flow_module.html",
