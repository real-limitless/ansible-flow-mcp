      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_username",
      "displayName": "Auth Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Username to authenticate for API access with.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "connection_timeout",
      "displayName": "Connection Timeout",
      "type": "number",
      "required": false,
