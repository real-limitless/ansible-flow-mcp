      "description": "Alias (name) of the authentication flow.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_client_id",
      "displayName": "Auth Client Id",
      "type": "string",
      "required": false,
      "default": "admin-cli",
      "description": "OpenID Connect I(client_id) to authenticate to the API with.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_client_secret",
      "displayName": "Auth Client Secret",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Client Secret to use in conjunction with I(auth_client_id) (if required).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_keycloak_url",
      "displayName": "Auth Keycloak Url",
      "type": "string",
      "required": true,
      "default": null,
      "description": "URL to the Keycloak instance.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_password",
      "displayName": "Auth Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password to authenticate for API access with.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_realm",
      "displayName": "Auth Realm",
