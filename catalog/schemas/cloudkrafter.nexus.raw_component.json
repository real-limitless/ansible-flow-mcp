      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the component once uploaded.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password for basic authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "repository",
      "displayName": "Repository",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The URL of the repository to upload the component to.",
      "choices": null,
      "noLog": false,
      "suboptions": null
