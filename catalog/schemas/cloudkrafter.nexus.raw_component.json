    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Username for basic authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
