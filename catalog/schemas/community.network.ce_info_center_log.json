{
  "fqcn": "community.network.ce_info_center_log",
  "shortDescription": "Manages information center log configuration on HUAWEI CloudEngine switches.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/network/ce_info_center_log_module.html",
  "options": [
    {
      "name": "channel_id",
      "displayName": "Channel Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies a channel ID. The value is an integer ranging from 0 to 9.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "log_buff_enable",
      "displayName": "Log Buff Enable",
      "type": "string",
      "required": false,
      "default": "no_use",
      "description": "Enables the Switch to send logs to the log buffer.",
      "choices": [
        "no_use",
        "true",
        "false"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "log_buff_size",
      "displayName": "Log Buff Size",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the maximum number of logs in the log buffer. The value is an integer that ranges from 0 to 10240. If logbuffer-size is 0, logs are not displayed.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "log_enable",
      "displayName": "Log Enable",
      "type": "string",
      "required": false,
      "default": "no_use",
      "description": "Indicates whether log filtering is enabled.",
      "choices": [
        "no_use",
        "true",
        "false"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "log_level",
      "displayName": "Log Level",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies a log severity.",
      "choices": [
        "emergencies",
        "alert",
        "critical",
        "error",
        "warning",
        "notification",
        "informational",
        "debugging"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "log_time_stamp",
      "displayName": "Log Time Stamp",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Sets the timestamp format of logs.",
      "choices": [
        "date_boot",
        "date_second",
        "date_tenthsecond",
        "date_millisecond",
        "shortdate_second",
        "shortdate_tenthsecond",
        "shortdate_millisecond",
        "formatdate_second",
        "formatdate_tenthsecond",
        "formatdate_millisecond"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "module_name",
      "displayName": "Module Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the name of a module. The value is a module name in registration logs.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Determines whether the config should be present or not on the device.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
