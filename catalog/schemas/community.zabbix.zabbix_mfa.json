      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "clientid",
      "displayName": "Clientid",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Client ID provided by the Duo authentication service. Required when C(method_type=duo_universal_prompt).",
