      "description": "Certificate ID type",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "certname",
      "displayName": "Certname",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Certificate name",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "common_name",
      "displayName": "Common Name",
