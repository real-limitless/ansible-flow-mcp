      "default": null,
      "description": "Name of the locality",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the Certificate",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "organization_name",
      "displayName": "Organization Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Organization name",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "organization_unit_name",
      "displayName": "Organization Unit Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Department name",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Password for the Certificate used for authentication",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "private_key_file",
      "displayName": "Private Key File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Private key file to be uploaded (KEY format)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "secure_hash",
      "displayName": "Secure Hash",
      "type": "string",
      "required": false,
