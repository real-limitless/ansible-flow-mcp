    {
      "name": "ip_address",
      "displayName": "Ip Address",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of IP address Subject Alternative Names (SANs)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
