{
  "fqcn": "sophos.sophos_firewall.sfos_certificate",
  "shortDescription": "Manage Certificates (System > Certificates)",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/sophos/sophos_firewall/sfos_certificate_module.html",
  "options": [
    {
      "name": "action",
      "displayName": "Action",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Select an option for certificate management",
      "choices": [
        "UploadCertificate",
        "GenerateSelfSignedCertificate",
        "GenerateCertificateSigningRequest",
        "UploadRemoteCertificate",
        "RequestLetsEncryptCertificate",
        "LetsEncryptCertificate"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "certificate_file",
      "displayName": "Certificate File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Certificate file to be uploaded (PEM, DER, CER, P7B, PFX, P12 formats)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "certificate_format",
      "displayName": "Certificate Format",
      "type": "string",
      "required": false,
      "default": "pem",
      "description": "Format of Certificate file",
      "choices": [
        "pem",
        "der",
        "cer",
        "pkcs7",
        "pkcs12",
        "p7b"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "certificate_id",
      "displayName": "Certificate Id",
      "type": "string",
      "required": false,
