{
  "fqcn": "community.google.gce_tag",
  "shortDescription": "add or remove tag(s) to/from GCE instances",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/google/gce_tag_module.html",
  "options": [
    {
      "name": "instance_name",
      "displayName": "Instance Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The name of the GCE instance to add/remove tags. Required if C(instance_pattern) is not specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "instance_pattern",
      "displayName": "Instance Pattern",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The pattern of GCE instance names to match for adding/removing tags.  Full-Python regex is supported. See U(https://docs.python.org/2/library/re.html) for details. If C(instance_name) is not specified, this field is required.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pem_file",
      "displayName": "Pem File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Path to the PEM file associated with the service account email.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "project_id",
      "displayName": "Project Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Your GCE project ID.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "service_account_email",
      "displayName": "Service Account Email",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Service account email.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired state of the tags.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "tags",
      "displayName": "Tags",
      "type": "list",
      "required": true,
      "default": null,
      "description": "Comma-separated list of tags to add or remove.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone",
      "displayName": "Zone",
      "type": "string",
      "required": false,
      "default": "us-central1-a",
      "description": "The zone of the disk specified by source.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
