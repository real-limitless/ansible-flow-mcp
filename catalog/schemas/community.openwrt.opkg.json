{
  "fqcn": "community.openwrt.opkg",
  "shortDescription": "Manage packages with opkg on OpenWrt",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/openwrt/opkg_module.html",
  "options": [
    {
      "name": "autoremove",
      "displayName": "Autoremove",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Remove dependencies that are no longer required when removing a package.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "force",
      "displayName": "Force",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Force option to pass to opkg.",
      "choices": [
        "depends",
        "maintainer",
        "reinstall",
        "overwrite",
        "downgrade",
        "space",
        "postinstall",
        "remove",
        "checksum",
        "removal-of-dependent-packages"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the package(s) to install or remove. Multiple packages can be specified as a comma-separated list.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "nodeps",
      "displayName": "Nodeps",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Do not follow dependencies.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the package should be installed or removed.",
      "choices": [
        "absent",
        "installed",
        "present",
        "removed"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "update_cache",
      "displayName": "Update Cache",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Update the package cache (C(opkg update)) before performing the operation.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
