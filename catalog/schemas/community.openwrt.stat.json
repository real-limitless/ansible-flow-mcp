{
  "fqcn": "community.openwrt.stat",
  "shortDescription": "Retrieve file or file system status on OpenWrt targets",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/openwrt/stat_module.html",
  "options": [
    {
      "name": "checksum_algorithm",
      "displayName": "Checksum Algorithm",
      "type": "string",
      "required": false,
      "default": "sha1",
      "description": "Algorithm to use for checksumming the file.",
      "choices": [
        "md5",
        "sha1",
        "sha224",
        "sha256",
        "sha384",
        "sha512"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "follow",
      "displayName": "Follow",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Whether to follow symlinks.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "get_checksum",
      "displayName": "Get Checksum",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether to get the checksum of the file. Uses the algorithm specified in O(checksum_algorithm).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "get_md5",
      "displayName": "Get Md5",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether to get the MD5 checksum of the file.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "get_mime",
      "displayName": "Get Mime",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether to get the MIME type of the file. Note that this is not fully implemented and returns V(unknown).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "path",
      "displayName": "Path",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The full path of the file/directory to get the facts of.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
