{
  "fqcn": "community.general.znode",
  "shortDescription": "Create, delete, retrieve, and update znodes using ZooKeeper",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/znode_module.html",
  "options": [
    {
      "name": "auth_credential",
      "displayName": "Auth Credential",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The authentication credential value. Depends on O(auth_scheme). The format for O(auth_scheme=digest) is C(user:password), and the format for O(auth_scheme=sasl) is C(user:password).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_scheme",
      "displayName": "Auth Scheme",
      "type": "string",
      "required": false,
      "default": "digest",
      "description": "Authentication scheme.",
      "choices": [
        "digest",
        "sasl"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hosts",
      "displayName": "Hosts",
      "type": "string",
      "required": true,
      "default": null,
      "description": "A list of ZooKeeper servers (format V([server]:[port])).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The path of the znode.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "op",
      "displayName": "Op",
      "type": "string",
      "required": false,
      "default": null,
      "description": "An operation to perform. Mutually exclusive with state.",
      "choices": [
        "get",
        "wait",
        "list"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "recursive",
      "displayName": "Recursive",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Recursively delete node and all its children.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The state to enforce. Mutually exclusive with op.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 300,
      "description": "The amount of time to wait for a node to appear.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "use_tls",
      "displayName": "Use Tls",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Using TLS/SSL or not.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "value",
      "displayName": "Value",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The value assigned to the znode.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
