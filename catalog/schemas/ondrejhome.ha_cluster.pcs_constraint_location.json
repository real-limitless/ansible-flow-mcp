{
  "fqcn": "ondrejhome.ha_cluster.pcs_constraint_location",
  "shortDescription": "wrapper module for 'pcs constraint location'",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ondrejhome/ha_cluster/pcs_constraint_location_module.html",
  "options": [
    {
      "name": "cib_file",
      "displayName": "Cib File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Apply changes to specified file containing cluster CIB instead of running cluster. This module requires the file to already contain cluster configuration.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "constraint_id",
      "displayName": "Constraint Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "unique name for the constraint Required by I(rule)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "node_name",
      "displayName": "Node Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "node name for constraints One of C(rule) or C(node_name) is required Mutually exclusive with C(rule)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "resource",
      "displayName": "Resource",
      "type": "string",
      "required": true,
      "default": null,
      "description": "resource for constraint",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "resource_discovery",
      "displayName": "Resource Discovery",
      "type": "string",
      "required": false,
      "default": null,
      "description": "resource-discovery mode, requires both I(node_name) and I(constraint_id) to be specified",
      "choices": [
        "always",
        "never",
        "exclusive"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "rule",
      "displayName": "Rule",
      "type": "string",
      "required": false,
      "default": null,
      "description": "rule expression for constraints One of C(rule) or C(node_name) is required Mutually exclusive with C(node_name)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "score",
      "displayName": "Score",
      "type": "string",
      "required": false,
      "default": "INFINITY",
      "description": "constraint score in range -INFINITY..0..INFINITY",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "'present' - ensure that cluster constraint exists 'absent' - ensure cluster constraints doesn't exist",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
