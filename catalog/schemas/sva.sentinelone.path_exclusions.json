{
  "fqcn": "sva.sentinelone.path_exclusions",
  "shortDescription": "Manage SentinelOne Path Exclusions",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/sva/sentinelone/path_exclusions_module.html",
  "options": [
    {
      "name": "console_url",
      "displayName": "Console Url",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Insert your management console URL",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": "",
      "description": "A short description to describe the exclusion",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ef_alerts_mitigation",
      "displayName": "Ef Alerts Mitigation",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Exclusion Function to exclude I(os_path) for alerts and mitigation",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ef_binary_vault",
      "displayName": "Ef Binary Vault",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Exclusion Function to exclude I(os_path) for Binary Vaults",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "groups",
      "displayName": "Groups",
      "type": "list",
      "required": false,
      "default": [],
      "description": "Set this option to set the scope to group level A list with groupnames which the exclusions are to be attached",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "include_subfolders",
      "displayName": "Include Subfolders",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If true, the exclusion will scope subfolders as well. Is ignored if I(os_path) is not a folder (does not end with / (linux) or  (windows))",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mode",
      "displayName": "Mode",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Defines the exclusion mode for this exclusion. Required if I(state=present)",
      "choices": [
        "suppress_alerts",
        "interoperability",
        "interoperability_extended",
        "performance_focus",
        "performance_focus_extended"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "os_path",
      "displayName": "Os Path",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Os path of the exclusion. If the path a folder, the path must end with / (linux) or  (windows)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "os_type",
      "displayName": "Os Type",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Define the operating system for the exclusion. Required if I(state=present)",
      "choices": [
        "windows",
        "linux"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "site_name",
      "displayName": "Site Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the site in SentinelOne",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Select the I(state) of exclusion",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "token",
      "displayName": "Token",
      "type": "string",
      "required": true,
      "default": null,
      "description": "SentinelOne API auth token to authenticate at the management API",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
