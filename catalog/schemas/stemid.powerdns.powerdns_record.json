{
  "fqcn": "stemid.powerdns.powerdns_record",
  "shortDescription": "Manage PowerDNS records",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/stemid/powerdns/powerdns_record_module.html",
  "options": [
    {
      "name": "content",
      "displayName": "Content",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Content of the record. Could be an ip address or hostname. Can be specified as list for multiple records of the same type and name. Mandatory when deleting a record and exclusive is disabled.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "disabled",
      "displayName": "Disabled",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether the record should be disabled.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "exclusive",
      "displayName": "Exclusive",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Whether to remove all other non-specified records from the recordset. Applicable to A, AAAA, MX, SRV, and TXT records.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Record name If name is not an FQDN, zone will be added at the end to create an FQDN",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pdns_api_key",
      "displayName": "Pdns Api Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The API key to use for authentication.",
      "choices": null,
      "noLog": true,
      "suboptions": null
    },
    {
      "name": "pdns_api_password",
      "displayName": "Pdns Api Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The password to use for basic authentication.",
      "choices": null,
      "noLog": true,
      "suboptions": null
    },
    {
      "name": "pdns_api_url",
      "displayName": "Pdns Api Url",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The URL of the PowerDNS API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pdns_api_username",
      "displayName": "Pdns Api Username",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The username to use for basic authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server",
      "displayName": "Server",
      "type": "string",
      "required": false,
      "default": "localhost",
      "description": "Server name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "set_ptr",
      "displayName": "Set Ptr",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If set to true, the server will find the matching reverse zone and create a PTR there. Existing PTR records are replaced. If no matching reverse Zone, an error is thrown. Only valid in client bodies, only valid for A and AAAA types.\n",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the record.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "strict_ssl_checking",
      "displayName": "Strict Ssl Checking",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Disables strict certificate checking",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ttl",
      "displayName": "Ttl",
      "type": "number",
      "required": false,
      "default": 86400,
      "description": "Record TTL",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "type",
      "displayName": "Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Record type",
      "choices": [
        "A",
        "AAAA",
        "CNAME",
        "MX",
        "PTR",
        "SOA",
        "SRV",
        "TXT",
        "LUA",
        "NS",
        "SSHFP"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone",
      "displayName": "Zone",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of zone where to ensure the record",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
