{
  "fqcn": "wttech.aem.replication",
  "shortDescription": "Manages content replication on AEM instance(s)",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/wttech/aem/replication_module.html",
  "options": [
    {
      "name": "command",
      "displayName": "Command",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The replication operation to perform. C(activate) - Activate (publish) content at specified path. C(deactivate) - Deactivate (unpublish) content at specified path. C(tree) - Activate content tree at specified path.",
      "choices": [
        "activate",
        "deactivate",
        "tree"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dry_run",
      "displayName": "Dry Run",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Simulate the operation without making changes.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ignore_deactivated",
      "displayName": "Ignore Deactivated",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Ignore already deactivated content.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "instance_id",
      "displayName": "Instance Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Use only AEM instance with specified ID.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "only_activated",
      "displayName": "Only Activated",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Only include already activated content.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "only_modified",
      "displayName": "Only Modified",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Only include modified content.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "path",
      "displayName": "Path",
      "type": "string",
      "required": true,
      "default": null,
      "description": "JCR path to replicate.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
