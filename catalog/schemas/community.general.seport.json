{
  "fqcn": "community.general.seport",
  "shortDescription": "Manages SELinux network port type definitions",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/seport_module.html",
  "options": [
    {
      "name": "ignore_selinux_state",
      "displayName": "Ignore Selinux State",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Run independent of selinux runtime state.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "local",
      "displayName": "Local",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Work with local modifications only.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ports",
      "displayName": "Ports",
      "type": "list",
      "required": true,
      "default": null,
      "description": "Ports or port ranges. Can be a list (since 2.6) or comma separated string.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "proto",
      "displayName": "Proto",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Protocol for the specified port. Support for V(dccp) and V(sctp) has been added in community.general 12.4.0.",
      "choices": [
        "tcp",
        "udp",
        "dccp",
        "sctp"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "reload",
      "displayName": "Reload",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Reload SELinux policy after commit.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "setype",
      "displayName": "Setype",
      "type": "string",
      "required": true,
      "default": null,
      "description": "SELinux type for the specified port.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Desired boolean value.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
