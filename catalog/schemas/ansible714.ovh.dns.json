      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone",
      "displayName": "Zone",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The zone to modify",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
