{
  "fqcn": "infra.osbuild.repository",
  "shortDescription": "Add source repository to add custom packages",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/infra/osbuild/repository_module.html",
  "options": [
    {
      "name": "base_url",
      "displayName": "Base Url",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Base url of the source",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "check_gpg",
      "displayName": "Check Gpg",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Check that the gpg keys match",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "check_ssl",
      "displayName": "Check Ssl",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Check if the https certificates are valid",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "gpgkey_paths",
      "displayName": "Gpgkey Paths",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of gpg key paths to pull gpg keys from",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "gpgkey_urls",
      "displayName": "Gpgkey Urls",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of gpg key urls",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "repo_name",
      "displayName": "Repo Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the source",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "rhsm",
      "displayName": "Rhsm",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Set true if the repository source requires a subscription",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Whether to install (present) or remove (absent)",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "type",
      "displayName": "Type",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Url type",
      "choices": [
        "yum-baseurl",
        "yum-mirrorlist",
        "yum-metalink"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
