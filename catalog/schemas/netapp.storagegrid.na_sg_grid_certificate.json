{
  "fqcn": "netapp.storagegrid.na_sg_grid_certificate",
  "shortDescription": "Manage the Storage API and Grid Management certificates on StorageGRID.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/netapp/storagegrid/na_sg_grid_certificate_module.html",
  "options": [
    {
      "name": "api_url",
      "displayName": "Api Url",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The url to the StorageGRID Admin Node REST API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "auth_token",
      "displayName": "Auth Token",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The authorization token for the API request",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ca_bundle",
      "displayName": "Ca Bundle",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Intermediate CA certificate bundle in concatenated PEM-encoding. Omit if there is no intermediate CA.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "private_key",
      "displayName": "Private Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Certificate private key in PEM-encoding. Required if I(server_certificate) is specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server_certificate",
      "displayName": "Server Certificate",
      "type": "string",
      "required": false,
      "default": null,
      "description": "X.509 server certificate in PEM-encoding.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the specified certificate should be set.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "type",
      "displayName": "Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Which certificate to update.",
      "choices": [
        "storage-api",
        "management"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Should https certificates be validated?",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
