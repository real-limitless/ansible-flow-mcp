{
  "fqcn": "community.google.gce_pd",
  "shortDescription": "utilize GCE persistent disk resources",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/google/gce_pd_module.html",
  "options": [
    {
      "name": "credentials_file",
      "displayName": "Credentials File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "path to the JSON file associated with the service account email",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "delete_on_termination",
      "displayName": "Delete On Termination",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "If C(yes), deletes the volume when instance is terminated",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "detach_only",
      "displayName": "Detach Only",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "do not destroy the disk, merely detach it from an instance",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "disk_type",
      "displayName": "Disk Type",
      "type": "string",
      "required": false,
      "default": "pd-standard",
      "description": "Specify a C(pd-standard) disk or C(pd-ssd) for an SSD disk.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "external_projects",
      "displayName": "External Projects",
      "type": "list",
      "required": false,
      "default": null,
      "description": "A list of other projects (accessible with the provisioning credentials) to be searched for the image.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "image",
      "displayName": "Image",
      "type": "string",
      "required": false,
      "default": null,
      "description": "the source image to use for the disk",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "image_family",
      "displayName": "Image Family",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The image family to use to create the instance. If I(image) has been used I(image_family) is ignored. Cannot specify both I(image) and I(source).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "instance_name",
      "displayName": "Instance Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "instance name if you wish to attach or detach the disk",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mode",
      "displayName": "Mode",
      "type": "string",
      "required": false,
      "default": "READ_ONLY",
      "description": "GCE mount mode of disk, READ_ONLY (default) or READ_WRITE",
      "choices": [
        "READ_WRITE",
        "READ_ONLY"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "name of the disk",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pem_file",
      "displayName": "Pem File",
      "type": "string",
      "required": false,
      "default": null,
      "description": "path to the pem file associated with the service account email This option is deprecated. Use 'credentials_file'.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "project_id",
      "displayName": "Project Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "your GCE project ID",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "service_account_email",
      "displayName": "Service Account Email",
      "type": "string",
      "required": false,
      "default": null,
      "description": "service account email",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "size_gb",
      "displayName": "Size Gb",
      "type": "string",
      "required": false,
      "default": "10",
      "description": "whole integer size of disk (in GB) to create, default is 10 GB",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "snapshot",
      "displayName": "Snapshot",
      "type": "string",
      "required": false,
      "default": null,
      "description": "the source snapshot to use for the disk",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "desired state of the persistent disk Available choices are: C(active), C(present), C(absent), C(deleted).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "zone",
      "displayName": "Zone",
      "type": "string",
      "required": false,
      "default": "us-central1-b",
      "description": "zone in which to create the disk",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
