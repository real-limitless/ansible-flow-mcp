{
  "fqcn": "ansible.builtin.service",
  "shortDescription": "Manage services.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ansible/builtin/service_module.html",
  "options": [
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Name of the service.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": null,
      "description": "started/stopped/etc.",
      "choices": [
        "started",
        "stopped",
        "restarted",
        "reloaded"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "enabled",
      "displayName": "Enabled",
      "type": "boolean",
      "required": false,
      "default": null,
      "description": "Whether the service should start on boot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "daemon_reload",
      "displayName": "Daemon Reload",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Run daemon-reload before doing any other operations.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ]
}
