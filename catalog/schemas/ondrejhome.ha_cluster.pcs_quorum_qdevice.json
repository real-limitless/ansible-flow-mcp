{
  "fqcn": "ondrejhome.ha_cluster.pcs_quorum_qdevice",
  "shortDescription": "wrapper module for 'pcs quorum setup/destroy/change qdevice setting'",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ondrejhome/ha_cluster/pcs_quorum_qdevice_module.html",
  "options": [
    {
      "name": "algorithm",
      "displayName": "Algorithm",
      "type": "string",
      "required": false,
      "default": "ffsplit",
      "description": "algorithm use by the cluster",
      "choices": [
        "ffsplit",
        "lms"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "allowed_qdevice_changes",
      "displayName": "Allowed Qdevice Changes",
      "type": "string",
      "required": false,
      "default": "none",
      "description": "'none' - existing qdevice and algorithm must match 'update' - allow qdevice and/or algorithm update",
      "choices": [
        "none",
        "update"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "qdevice",
      "displayName": "Qdevice",
      "type": "string",
      "required": false,
      "default": null,
      "description": "qdevice name (hostname or IP address)",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "'present' - ensure that the qdevice exists 'absent' - ensure qdevice doesn't exist",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
