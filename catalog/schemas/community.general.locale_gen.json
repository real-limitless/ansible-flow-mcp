{
  "fqcn": "community.general.locale_gen",
  "shortDescription": "Creates or removes locales",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/locale_gen_module.html",
  "options": [
    {
      "name": "name",
      "displayName": "Name",
      "type": "list",
      "required": true,
      "default": null,
      "description": "Name and encoding of the locales, such as V(en_GB.UTF-8). Before community.general 9.3.0, this was a string. Using a string still works.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the locales shall be present.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
