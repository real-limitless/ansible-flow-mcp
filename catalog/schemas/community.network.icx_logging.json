{
  "fqcn": "community.network.icx_logging",
  "shortDescription": "Manage logging on Ruckus ICX 7000 series switches",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/network/icx_logging_module.html",
  "options": [
    {
      "name": "aggregate",
      "displayName": "Aggregate",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of logging definitions.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "check_running_config",
      "displayName": "Check Running Config",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Check running configuration. This can be set as environment variable. Module will use environment variable value(default:True), unless it is overridden, by specifying it as module parameter.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dest",
      "displayName": "Dest",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Destination of the logs.",
      "choices": [
        "on",
        "host",
        "console",
        "buffered",
        "persistence",
        "rfc5424"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "facility",
      "displayName": "Facility",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies log facility to log messages from the device.",
      "choices": [
        "auth",
        "cron",
        "daemon",
        "kern",
        "local0",
        "local1",
        "local2",
        "local3",
        "local4",
        "local5",
        "local6",
        "local7",
        "user",
        "lpr",
        "mail",
        "news",
        "syslog",
        "sys9",
        "sys10",
        "sys11",
        "sys12",
        "sys13",
        "sys14",
        "user",
        "uucp"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "level",
      "displayName": "Level",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Specifies the message level.",
      "choices": [
        "alerts",
        "critical",
        "debugging",
        "emergencies",
        "errors",
        "informational",
        "notifications",
        "warnings"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "ipv4 address/ipv6 address/name of  syslog server.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the logging configuration.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "udp_port",
      "displayName": "Udp Port",
      "type": "string",
      "required": false,
      "default": null,
      "description": "UDP port of destination host(syslog server).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
