{
  "fqcn": "community.digitalocean.digital_ocean_snapshot",
  "shortDescription": "Create and delete DigitalOcean snapshots",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/digitalocean/digital_ocean_snapshot_module.html",
  "options": [
    {
      "name": "baseurl",
      "displayName": "Baseurl",
      "type": "string",
      "required": false,
      "default": "https://api.digitalocean.com/v2",
      "description": "DigitalOcean API base url.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "droplet_id",
      "displayName": "Droplet Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Droplet ID to snapshot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "oauth_token",
      "displayName": "Oauth Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "DigitalOcean OAuth token. There are several other environment variables which can be used to provide this value. i.e., - C(DO_API_TOKEN), C(DO_API_KEY), C(DO_OAUTH_TOKEN) and C(OAUTH_TOKEN).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "snapshot_id",
      "displayName": "Snapshot Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Snapshot ID to delete.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "snapshot_name",
      "displayName": "Snapshot Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Name of the snapshot to create.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "snapshot_tags",
      "displayName": "Snapshot Tags",
      "type": "list",
      "required": false,
      "default": [],
      "description": "List of tags to apply to the volume snapshot. Only applies to volume snapshots (not Droplets).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "snapshot_type",
      "displayName": "Snapshot Type",
      "type": "string",
      "required": false,
      "default": "droplet",
      "description": "Specifies the type of snapshot information to be create or delete. If set to C(droplet), then a Droplet snapshot is created. If set to C(volume), then a volume snapshot is created.",
      "choices": [
        "droplet",
        "volume"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Whether the snapshot should be present (created) or absent (deleted).",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "The timeout in seconds used for polling DigitalOcean's API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "If set to C(no), the SSL certificates will not be validated. This should only set to C(no) used on personally controlled sites using self-signed certificates.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "volume_id",
      "displayName": "Volume Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Volume ID to snapshot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "wait",
      "displayName": "Wait",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Wait for the snapshot to be created before returning.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "wait_timeout",
      "displayName": "Wait Timeout",
      "type": "number",
      "required": false,
      "default": 120,
      "description": "How long before wait gives up, in seconds, when creating a snapshot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
