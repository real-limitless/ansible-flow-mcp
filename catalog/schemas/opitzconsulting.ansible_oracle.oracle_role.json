{
  "fqcn": "opitzconsulting.ansible_oracle.oracle_role",
  "shortDescription": "Manage users/roles in an Oracle database",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/opitzconsulting/ansible_oracle/oracle_role_module.html",
  "options": [
    {
      "name": "grants",
      "displayName": "Grants",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The privileges granted to the new role. Can be a string or a list",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hostname",
      "displayName": "Hostname",
      "type": "string",
      "required": false,
      "default": "localhost",
      "description": "The Oracle database host",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "mode",
      "displayName": "Mode",
      "type": "string",
      "required": true,
      "default": "normal",
      "description": "The mode with which to connect to the database",
      "choices": [
        "normal",
        "sysdba"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The Oracle user password for 'user'",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "string",
      "required": false,
      "default": 1521,
      "description": "The listener port number on the host",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "role",
      "displayName": "Role",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The role that should get grants added/removed",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "service_name",
      "displayName": "Service Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The database service name to connect to",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
