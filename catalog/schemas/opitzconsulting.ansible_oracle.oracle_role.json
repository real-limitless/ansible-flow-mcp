        "absent",
        "REMOVEALL"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "user",
      "displayName": "User",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The Oracle user name to connect to the database",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
