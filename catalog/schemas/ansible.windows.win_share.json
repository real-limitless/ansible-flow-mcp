{
  "fqcn": "ansible.windows.win_share",
  "shortDescription": "Manage Windows shares",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/ansible/windows/win_share_module.html",
  "options": [
    {
      "name": "caching_mode",
      "displayName": "Caching Mode",
      "type": "string",
      "required": false,
      "default": "Manual",
      "description": "Set the CachingMode for this share.",
      "choices": [
        "BranchCache",
        "Documents",
        "Manual",
        "None",
        "Programs",
        "Unknown"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "change",
      "displayName": "Change",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specify user list that should get read and write access on share, separated by comma.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "deny",
      "displayName": "Deny",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specify user list that should get no access, regardless of implied access on share, separated by comma.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
      "displayName": "Description",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Share description.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "encrypt",
      "displayName": "Encrypt",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Sets whether to encrypt the traffic to the share or not.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "full",
      "displayName": "Full",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specify user list that should get full access on share, separated by comma.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "list",
      "displayName": "List",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Specify whether to allow or deny file listing, in case user has no permission on share. Also known as Access-Based Enumeration.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Share name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "path",
      "displayName": "Path",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Share directory.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "read",
      "displayName": "Read",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specify user list that should get read access on share, separated by comma.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "rule_action",
      "displayName": "Rule Action",
      "type": "string",
      "required": false,
      "default": "set",
      "description": "Whether to add or set (replace) access control entries.",
      "choices": [
        "set",
        "add"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "scope_name",
      "displayName": "Scope Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the scope name of the share. For use with Windows Server failover cluster file server resources. When defined, I(path) must be located on a cluster shared volume/disk.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
