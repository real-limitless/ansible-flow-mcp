{
  "fqcn": "community.network.cnos_logging",
  "shortDescription": "Manage logging on network devices",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/network/cnos_logging_module.html",
  "options": [
    {
      "name": "aggregate",
      "displayName": "Aggregate",
      "type": "string",
      "required": false,
      "default": null,
      "description": "List of logging definitions.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "dest",
      "displayName": "Dest",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Destination of the logs. Lenovo uses the term server instead of host in its CLI.",
      "choices": [
        "server",
        "console",
        "monitor",
        "logfile"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "facility",
      "displayName": "Facility",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Set logging facility. This is applicable only for server logging",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "level",
      "displayName": "Level",
      "type": "string",
      "required": false,
      "default": 5,
      "description": "Set logging severity levels. 0-emerg;1-alert;2-crit;3-err;4-warn; 5-notif;6-inform;7-debug",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "If value of C(dest) is I(file) it indicates file-name and for I(server) indicates the server name to be notified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "size",
      "displayName": "Size",
      "type": "string",
      "required": false,
      "default": 10485760,
      "description": "Size of buffer. The acceptable value is in range from 4096 to 4294967295 bytes.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the logging configuration.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
