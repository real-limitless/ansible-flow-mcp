      "noLog": false,
      "suboptions": null
    },
    {
      "name": "app_uuid",
      "displayName": "App Uuid",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Application identifier of snapshot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "change_name",
      "displayName": "Change Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Change name of the existing snapshot.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "description",
