        "mirrored_over_3_nodes",
        "mirrored_over_4_nodes",
        "mirrored_over_5_nodes",
        "mirrored_over_6_nodes",
        "mirrored_over_7_nodes",
        "mirrored_over_8_nodes"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "set_write_performance_optimization",
      "displayName": "Set Write Performance Optimization",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Action to set write performance optimization.",
      "choices": [
        "enable_smartcache",
        "disable_smartcache"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The state option is used to mention the existence of file pool policy.",
      "choices": [
        "absent",
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "verify_ssl",
      "displayName": "Verify Ssl",
      "type": "boolean",
      "required": true,
      "default": null,
      "description": "boolean variable to specify whether to validate SSL certificate or not. C(true) - indicates that the SSL certificate should be verified. C(false) - indicates that the SSL certificate should not be verified.",
      "choices": [
        true,
        false
      ],
      "noLog": false,
      "suboptions": null
    }
