{
  "fqcn": "community.general.timezone",
  "shortDescription": "Configure timezone setting.",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/timezone_module.html",
  "options": [
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Name of the timezone, e.g. America/New_York.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "hwclock",
      "displayName": "Hwclock",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Whether the hardware clock is in UTC or local time.",
      "choices": [
        "local",
        "UTC"
      ],
      "noLog": false,
      "suboptions": null
    }
  ]
}
