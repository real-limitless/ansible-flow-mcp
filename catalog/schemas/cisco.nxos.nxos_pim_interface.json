      "type": "string",
      "required": false,
      "default": null,
      "description": "Enables BFD for PIM at the interface level. This overrides the bfd variable set at the pim global level. Valid values are 'enable', 'disable' or 'default'. Dependency: ''feature bfd''",
      "choices": [
        "enable",
        "disable",
        "default"
      ],
      "noLog": false,
      "suboptions": null
