{
  "fqcn": "containers.podman.podman_quadlet_info",
  "shortDescription": "Gather information about Podman Quadlets",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/containers/podman/podman_quadlet_info_module.html",
  "options": [
    {
      "name": "cmd_args",
      "displayName": "Cmd Args",
      "type": "list",
      "required": false,
      "default": null,
      "description": "Extra global arguments to pass to the C(podman) command (e.g., C(--log-level=debug)). These are placed after the executable and before the subcommand.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Return additional debug information.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "executable",
      "displayName": "Executable",
      "type": "string",
      "required": false,
      "default": "podman",
      "description": "Path to the podman executable.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "kinds",
      "displayName": "Kinds",
      "type": "list",
      "required": false,
      "default": null,
      "description": "List of quadlet kinds to filter by (based on file suffix). For example, C(container) matches quadlets ending with C(.container).",
      "choices": [
        "container",
        "pod",
        "network",
        "volume",
        "kube",
        "image"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Name of the quadlet to print content for. When specified, runs C(podman quadlet print) instead of list.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "quadlet_dir",
      "displayName": "Quadlet Dir",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Filter results to quadlets whose path is under this directory. By default no filtering is applied.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
