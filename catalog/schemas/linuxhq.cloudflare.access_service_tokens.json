      "default": null,
      "description": "Cloudflare account identifier.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_token",
      "displayName": "Api Token",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Cloudflare API token with permissions to manage Access service tokens.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "duration",
      "displayName": "Duration",
      "type": "string",
