      "displayName": "Format",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Image file format, e.g. raw or qcow2, defaulting to image extension.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "image",
      "displayName": "Image",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Image file path (relative or absolute) or URL. Required if C(state) is C(present).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
