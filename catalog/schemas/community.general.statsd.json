{
  "fqcn": "community.general.statsd",
  "shortDescription": "Send metrics to StatsD",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/statsd_module.html",
  "options": [
    {
      "name": "delta",
      "displayName": "Delta",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If the metric is of type V(gauge), change the value by O(delta).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": false,
      "default": "localhost",
      "description": "StatsD host (hostname or IP) to send metrics to.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "metric",
      "displayName": "Metric",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the metric.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "metric_prefix",
      "displayName": "Metric Prefix",
      "type": "string",
      "required": false,
      "default": "",
      "description": "The prefix to add to the metric.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "metric_type",
      "displayName": "Metric Type",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The type of metric.",
      "choices": [
        "counter",
        "gauge"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "port",
      "displayName": "Port",
      "type": "number",
      "required": false,
      "default": 8125,
      "description": "The port on O(host) which StatsD is listening on.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "protocol",
      "displayName": "Protocol",
      "type": "string",
      "required": false,
      "default": "udp",
      "description": "The transport protocol to send metrics over.",
      "choices": [
        "udp",
        "tcp"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "State of the check, only V(present) makes sense.",
      "choices": [
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "timeout",
      "displayName": "Timeout",
      "type": "number",
      "required": false,
      "default": 1.0,
      "description": "Sender timeout, only applicable if O(protocol) is V(tcp).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "value",
      "displayName": "Value",
      "type": "number",
      "required": true,
      "default": null,
      "description": "The value of the metric.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
