    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specifies the DNS host name or address for connecting to the remote device over the specified transport.  The value of host is used as the destination address for the transport.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
