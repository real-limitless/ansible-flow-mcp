{
  "fqcn": "infinidat.infinibox.infini_event",
  "shortDescription": "Create custom events on Infinibox",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/infinidat/infinibox/infini_event_module.html",
  "options": [
    {
      "name": "description_template",
      "displayName": "Description Template",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The content of the custom event",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "level",
      "displayName": "Level",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The level of the custom event",
      "choices": [
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Infinibox User password.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Creates a custom event when present. Stat is not yet implemented. There is no way to remove events once posted, so abent is also not implemented.",
      "choices": [
        "present"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "stay_logged_in",
      "displayName": "Stay Logged In",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "If True, persist API session to disk. Load the session on subsequent module calls. Persisted sessions are only usable for stay_logged_in_minutes.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "stay_logged_in_minutes",
      "displayName": "Stay Logged In Minutes",
      "type": "number",
      "required": false,
      "default": 5,
      "description": "Number of minutes for which a persisted session may be reused. After this time, the session data will be deleted. The time should be shorter than the IBOX session timeout time.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "system",
      "displayName": "System",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Infinibox Hostname or IPv4 Address.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "user",
      "displayName": "User",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Infinibox User username with sufficient priveledges ( see notes ).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "visibility",
      "displayName": "Visibility",
      "type": "string",
      "required": false,
      "default": "CUSTOMER",
      "description": "The event's visibility",
      "choices": [
        "CUSTOMER",
        "INFINIDAT"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
