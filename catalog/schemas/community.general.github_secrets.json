{
  "fqcn": "community.general.github_secrets",
  "shortDescription": "Manage GitHub repository or organization secrets",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/github_secrets_module.html",
  "options": [
    {
      "name": "api_url",
      "displayName": "Api Url",
      "type": "string",
      "required": false,
      "default": "https://api.github.com",
      "description": "The base URL for the GitHub API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "key",
      "displayName": "Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The name of the secret.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "organization",
      "displayName": "Organization",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The GitHub username or organization name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "repository",
      "displayName": "Repository",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The name of the repository. If not provided, the secret will be managed at the organization level.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The desired state of the secret.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "token",
      "displayName": "Token",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The GitHub token used for authentication.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "value",
      "displayName": "Value",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The value of the secret. Required when O(state=present).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "visibility",
      "displayName": "Visibility",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The visibility of the secret when set at the organization level. Required when O(state=present) and O(repository) is not set.",
      "choices": [
        "all",
        "private",
        "selected"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
