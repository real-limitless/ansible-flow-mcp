{
  "fqcn": "community.general.syslogger",
  "shortDescription": "Log messages in the syslog",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/syslogger_module.html",
  "options": [
    {
      "name": "facility",
      "displayName": "Facility",
      "type": "string",
      "required": false,
      "default": "daemon",
      "description": "Set the log facility.",
      "choices": [
        "kern",
        "user",
        "mail",
        "daemon",
        "auth",
        "lpr",
        "news",
        "uucp",
        "cron",
        "syslog",
        "local0",
        "local1",
        "local2",
        "local3",
        "local4",
        "local5",
        "local6",
        "local7"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ident",
      "displayName": "Ident",
      "type": "string",
      "required": false,
      "default": "ansible_syslogger",
      "description": "Specify the name of application name which is sending the log to syslog.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "log_pid",
      "displayName": "Log Pid",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Log the PID in brackets.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "msg",
      "displayName": "Msg",
      "type": "string",
      "required": true,
      "default": null,
      "description": "This is the message to place in syslog.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "priority",
      "displayName": "Priority",
      "type": "string",
      "required": false,
      "default": "info",
      "description": "Set the log priority.",
      "choices": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
