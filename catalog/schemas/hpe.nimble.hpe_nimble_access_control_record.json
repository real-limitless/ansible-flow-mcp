{
  "fqcn": "hpe.nimble.hpe_nimble_access_control_record",
  "shortDescription": "Manage the HPE Nimble Storage access control records",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/hpe/nimble/hpe_nimble_access_control_record_module.html",
  "options": [
    {
      "name": "apply_to",
      "displayName": "Apply To",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The type of object to which this access control record applies.",
      "choices": [
        "volume",
        "snapshot",
        "both"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "chap_user",
      "displayName": "Chap User",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Name for the CHAP user.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "host",
      "displayName": "Host",
      "type": "string",
      "required": true,
      "default": null,
      "description": "HPE Nimble Storage IP address.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "initiator_group",
      "displayName": "Initiator Group",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The initiator group name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "lun",
      "displayName": "Lun",
      "type": "number",
      "required": false,
      "default": null,
      "description": "If this access control record applies to a regular volume, this attribute is the volume's LUN (Logical Unit Number). If the access protocol is iSCSI, the LUN will be 0. However, if the access protocol is Fibre Channel, the LUN will be in the range from 0 to 2047.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "password",
      "displayName": "Password",
      "type": "string",
      "required": true,
      "default": null,
      "description": "HPE Nimble Storage password.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The access control record operation.",
      "choices": [
        "present",
        "absent",
        "create"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "username",
      "displayName": "Username",
      "type": "string",
      "required": true,
      "default": null,
      "description": "HPE Nimble Storage user name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "volume",
      "displayName": "Volume",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the volume that this access control record applies to.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
