        "linked",
        "present",
        "removed",
        "uninstalled",
        "unlinked",
        "upgraded"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "update_homebrew",
      "displayName": "Update Homebrew",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Update homebrew itself first.",
      "choices": null,
      "noLog": false,
