  "options": [
    {
      "name": "force_formula",
      "displayName": "Force Formula",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Force the package(s) to be treated as a formula (equivalent to C(brew --formula)). To install a cask, use the M(community.general.homebrew_cask) module.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "install_options",
      "displayName": "Install Options",
      "type": "list",
