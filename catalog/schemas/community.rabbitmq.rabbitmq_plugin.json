{
  "fqcn": "community.rabbitmq.rabbitmq_plugin",
  "shortDescription": "Manage RabbitMQ plugins",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/rabbitmq/rabbitmq_plugin_module.html",
  "options": [
    {
      "name": "broker_state",
      "displayName": "Broker State",
      "type": "string",
      "required": false,
      "default": "online",
      "description": "Specify whether the broker should be online or offline for the plugin change.",
      "choices": [
        "online",
        "offline"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "names",
      "displayName": "Names",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Comma-separated list of plugin names. Also, accepts plugin name.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "new_only",
      "displayName": "New Only",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Only enable missing plugins. Does not disable plugins that are not in the names list.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "prefix",
      "displayName": "Prefix",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Specify a custom install prefix to a Rabbit.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "enabled",
      "description": "Specify if plugins are to be enabled or disabled.",
      "choices": [
        "enabled",
        "disabled"
      ],
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
