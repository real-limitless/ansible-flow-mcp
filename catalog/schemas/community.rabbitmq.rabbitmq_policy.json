{
  "fqcn": "community.rabbitmq.rabbitmq_policy",
  "shortDescription": "Manage the state of policies in RabbitMQ",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/rabbitmq/rabbitmq_policy_module.html",
  "options": [
    {
      "name": "apply_to",
      "displayName": "Apply To",
      "type": "string",
      "required": false,
      "default": "all",
      "description": "What the policy applies to. Requires RabbitMQ 3.2.0 or later. For classic_queues, quorum_queues and streams RabbitMQ 3.12 or later is required",
      "choices": [
        "all",
        "exchanges",
        "queues",
        "classic_queues",
        "quorum_queues",
        "streams"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "ca_cert",
      "displayName": "Ca Cert",
      "type": "string",
      "required": false,
      "default": null,
      "description": "CA certificate to verify SSL connection to management API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "client_cert",
      "displayName": "Client Cert",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Client certificate to send on SSL connections to management API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "client_key",
      "displayName": "Client Key",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Private key matching the client certificate.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_host",
      "displayName": "Login Host",
      "type": "string",
      "required": false,
      "default": null,
      "description": "RabbitMQ host for connection.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_password",
      "displayName": "Login Password",
      "type": "string",
      "required": false,
      "default": null,
      "description": "RabbitMQ password for connection.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_port",
      "displayName": "Login Port",
      "type": "string",
      "required": false,
      "default": "15672",
      "description": "RabbitMQ management API port.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_protocol",
      "displayName": "Login Protocol",
      "type": "string",
      "required": false,
      "default": "http",
      "description": "RabbitMQ management API protocol.",
      "choices": [
        "http",
        "https"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "login_user",
      "displayName": "Login User",
      "type": "string",
      "required": false,
      "default": null,
      "description": "RabbitMQ user for connection.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "name",
      "displayName": "Name",
      "type": "string",
      "required": true,
      "default": null,
      "description": "The name of the policy to manage.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "node",
      "displayName": "Node",
      "type": "string",
      "required": false,
      "default": "rabbit",
      "description": "Erlang node name of the rabbit we wish to configure.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "pattern",
      "displayName": "Pattern",
      "type": "string",
      "required": false,
      "default": null,
      "description": "A regex of queues to apply the policy to. Required when C(state=present). This option is no longer required as of Ansible 2.9.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "priority",
      "displayName": "Priority",
      "type": "string",
      "required": false,
      "default": "0",
      "description": "The priority of the policy.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "The state of the policy.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "tags",
      "displayName": "Tags",
      "type": "dict",
      "required": false,
      "default": null,
      "description": "A dict or string describing the policy. Required when C(state=present). This option is no longer required as of Ansible 2.9.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "vhost",
      "displayName": "Vhost",
      "type": "string",
      "required": false,
      "default": "/",
      "description": "The name of the vhost to apply to.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
