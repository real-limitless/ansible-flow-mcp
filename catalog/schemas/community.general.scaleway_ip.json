{
  "fqcn": "community.general.scaleway_ip",
  "shortDescription": "Scaleway IP management module",
  "docUrl": "https://docs.ansible.com/ansible/latest/collections/community/general/scaleway_ip_module.html",
  "options": [
    {
      "name": "api_timeout",
      "displayName": "Api Timeout",
      "type": "number",
      "required": false,
      "default": 30,
      "description": "HTTP timeout to Scaleway API in seconds.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_token",
      "displayName": "Api Token",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Scaleway OAuth token. This is required if O(profile) is not specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "api_url",
      "displayName": "Api Url",
      "type": "string",
      "required": false,
      "default": "https://api.scaleway.com",
      "description": "Scaleway API URL.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "id",
      "displayName": "Id",
      "type": "string",
      "required": false,
      "default": null,
      "description": "ID of the Scaleway IP (UUID).",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "organization",
      "displayName": "Organization",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Scaleway organization identifier. Exactly one of O(project) and O(organization) must be specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "profile",
      "displayName": "Profile",
      "type": "string",
      "required": false,
      "default": null,
      "description": "The config profile in config file to load the Scaleway OAuth token from, use instead of O(api_token). It is also possible to set E(SCW_PROFILE) to use a SCW CLI config profile.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "project",
      "displayName": "Project",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Project identifier. Exactly one of O(project) and O(organization) must be specified.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "query_parameters",
      "displayName": "Query Parameters",
      "type": "dict",
      "required": false,
      "default": {},
      "description": "List of parameters passed to the query string.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "region",
      "displayName": "Region",
      "type": "string",
      "required": true,
      "default": null,
      "description": "Scaleway region to use (for example par1).",
      "choices": [
        "ams1",
        "EMEA-NL-EVS",
        "ams2",
        "ams3",
        "par1",
        "EMEA-FR-PAR1",
        "par2",
        "EMEA-FR-PAR2",
        "par3",
        "waw1",
        "EMEA-PL-WAW1",
        "waw2",
        "waw3"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "reverse",
      "displayName": "Reverse",
      "type": "string",
      "required": false,
      "default": null,
      "description": "Reverse to assign to the IP.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "server",
      "displayName": "Server",
      "type": "string",
      "required": false,
      "default": null,
      "description": "ID of the server you want to attach an IP to. To unattach an IP do not specify this option.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "state",
      "displayName": "State",
      "type": "string",
      "required": false,
      "default": "present",
      "description": "Indicate desired state of the IP.",
      "choices": [
        "present",
        "absent"
      ],
      "noLog": false,
      "suboptions": null
    },
    {
      "name": "validate_certs",
      "displayName": "Validate Certs",
      "type": "boolean",
      "required": false,
      "default": true,
      "description": "Validate SSL certs of the Scaleway API.",
      "choices": null,
      "noLog": false,
      "suboptions": null
    }
  ],
  "source": "ansible-doc"
}
